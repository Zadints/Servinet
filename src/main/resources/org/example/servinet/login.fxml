<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<AnchorPane fx:id="panelPrincipal" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.servinet.controllers.LoginController"
            style="-fx-background-color: #f4f6f9; -fx-background-radius: 15;"
            onMousePressed="#alPresionarRaton" onMouseDragged="#alArrastrarRaton">


    <Button text="X" onAction="#cerrarAplicacion"
            AnchorPane.topAnchor="15.0" AnchorPane.rightAnchor="15.0"
            style="-fx-background-color: transparent; -fx-text-fill: #888888; -fx-font-size: 18px; -fx-font-weight: bold; -fx-cursor: hand;"/>


    <VBox alignment="CENTER" spacing="20.0"
          AnchorPane.topAnchor="50.0" AnchorPane.bottomAnchor="50.0"
          AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0">

        <Label text="ServiNet - Acceso al Personal"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>

        <TextField fx:id="campoUsuario" promptText="Nombre de usuario"
                   maxWidth="250" style="-fx-font-size: 14px; -fx-padding: 10;"/>

        <PasswordField fx:id="campoPassword" promptText="Contraseña"
                       maxWidth="250" style="-fx-font-size: 14px; -fx-padding: 10;"/>

        <Button text="Ingresar al Sistema" fx:id="botonIngresar" onAction="#iniciarSesion"
                maxWidth="250" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10; -fx-font-weight: bold; -fx-cursor: hand;"/>
    </VBox>
</AnchorPane>