<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>

<StackPane
        xmlns="http://javafx.com/javafx/17.0.12"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.example.servinet.controllers.FormController">

    <VBox fx:id="root"
          alignment="CENTER"
          fillWidth="false"
          styleClass="form">

        <GridPane fx:id="formContent"
              alignment="CENTER"
              styleClass="form-content">

        </GridPane>
    </VBox>

</StackPane>
