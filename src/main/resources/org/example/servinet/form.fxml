        </VBox>
        <!-- PRIORIDAD -->
        <Label text="Prioridad:"
               styleClass="secondary-text"
               GridPane.rowIndex="1"/>


        <TextField fx:id="txtAntennaPriorityCreate"
                   promptText="ej: 1"
                   styleClass="secondary-input"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="2"/>
        <!-- NOMBRE -->
        <Label text="Nombre:"
               styleClass="secondary-text"
               GridPane.rowIndex="2"/>

        <TextField fx:id="txtAntennaCName"
                   promptText="Nombre de la antena"
                   styleClass="secondary-input"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="2"/>

        <!-- REPARACIÓN -->
        <Label text="En reparación:"
               styleClass="secondary-text"
               GridPane.rowIndex="3"/>

        <CheckBox fx:id="chkAntennaRepair"
                  styleClass="secondary-checkbox"
                  text="La antena está en reparación"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="3"/>

        <!-- MANTENIMIENTO -->
        <Label text="Mantenimiento:"
               styleClass="secondary-text"
               GridPane.rowIndex="4"/>

        <CheckBox fx:id="chkAntennaMaintenance"
                  styleClass="secondary-checkbox"
                  text="La antena requiere mantenimiento"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="4"/>

        <!-- DÍAS ENCENDIDA -->
        <Label text="Días encendida:"
               styleClass="secondary-text"
               GridPane.rowIndex="5"/>

        <TextField fx:id="txtAntennaDaysOn"
                   promptText="Cantidad de días"
                   styleClass="secondary-input"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="5"/>

        <!-- ÚLTIMO MANTENIMIENTO -->
        <Label text="Último mantenimiento:"
               styleClass="secondary-text"
               GridPane.rowIndex="6"/>

        <HBox GridPane.columnIndex="1"
              GridPane.rowIndex="6" spacing="3">
            <DatePicker fx:id="dpAntennaLastMaintenance"
                        promptText="Seleccionar fecha"
                        styleClass="secondary-date-picker"
                        prefWidth="200.0"
        />
            <ComboBox fx:id="cbxMaintenanceTime"
                      promptText="Hora"
                      styleClass="secondary-combo"
                      prefWidth="100.0"
                      >
                <!-- Esto le dice a FXML que manejará objetos LocalTime -->
                <items>
                    <fx:define>
                        <!-- (Opcional) Puedes dejarlo vacío si lo llenas desde Java -->
                    </fx:define>
                </items>
            </ComboBox>
        </HBox>

        <!-- IMAGEN -->
        <Label text="Imagen:"
               styleClass="secondary-text"
               GridPane.rowIndex="7"/>

        <HBox GridPane.columnIndex="1"
              GridPane.rowIndex="7"
              spacing="10"
              alignment="CENTER_LEFT">

            <Button fx:id="btnSelectImage"
                    onAction="#selectAntennaImage"
                    styleClass="tertiary-button"
                    text="Seleccionar imagen" />

            <ImageView fx:id="imgPreview"
                       fitWidth="50.0"
                       fitHeight="50.0"
                       preserveRatio="true">
            </ImageView>
        </HBox>

        <!-- ESTADO -->
        <Label text="Estado:"
               styleClass="secondary-text"
               GridPane.rowIndex="8"/>

        <ComboBox fx:id="cbxAntennaStatus"
                  prefWidth="200.0"
                  promptText="Seleccionar estado"
                  styleClass="secondary-combo"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="8"/>

