<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="root" alignment="CENTER" styleClass="form" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.servinet.ui.controllers.FormController">

    <!-- ================= USUARIO ================= -->

    <GridPane fx:id="menuUsuario" alignment="CENTER" hgap="12" styleClass="form-content" vgap="12">

        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" hgrow="NEVER" />
            <ColumnConstraints hgrow="ALWAYS" />
         <ColumnConstraints />
        </columnConstraints>

        <Label prefHeight="17.0" prefWidth="363.0" styleClass="primary-text" text="Crear usuario" GridPane.columnIndex="0" GridPane.columnSpan="2">
         <GridPane.margin>
            <Insets />
         </GridPane.margin></Label>
        <Label styleClass="secondary-text" text="Nombre:" GridPane.rowIndex="2" />
        <HBox spacing="10" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="2">

            <TextField fx:id="txtUserName" prefHeight="25.0" prefWidth="70.0" promptText="Nombre" styleClass="secondary-input" HBox.hgrow="ALWAYS" />

            <Label styleClass="secondary-text" text="Sector:" />

            <!--
            <ComboBox fx:id="cbxUserSector" prefHeight="25.0" prefWidth="120.0" promptText="Asignar Sector" styleClass="secondary-combo" />
-->
        </HBox>


        <Label styleClass="secondary-text" text="Email:" GridPane.rowIndex="3" />

        <TextField fx:id="txtUserEmail" promptText="Email" styleClass="secondary-input" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label styleClass="secondary-text" text="Rol:" GridPane.rowIndex="4" />

        <ComboBox fx:id="cbxUserRole" promptText="Seleccionar rol" styleClass="secondary-combo" GridPane.columnIndex="1" GridPane.rowIndex="4" />

        <Label styleClass="secondary-text" text="Contraseña:" GridPane.rowIndex="5" />

        <PasswordField fx:id="txtUserPassword" promptText="Contraseña" styleClass="secondary-input" GridPane.columnIndex="1" GridPane.rowIndex="5" />

        <Label styleClass="secondary-text" text="Imagen:" GridPane.rowIndex="6" />

        <Button onAction="#selectUserImage" styleClass="tertiary-button" text="Seleccionar imagen de perfil" GridPane.columnIndex="1" GridPane.rowIndex="6" />
        <HBox alignment="CENTER_RIGHT" spacing="12" GridPane.columnIndex="1" GridPane.rowIndex="7">

            <Button onAction="#createUser" styleClass="primary-button" text="Crear usuario" />

            <Button onAction="#closeForm" styleClass="secondary-button" text="Cancelar" />

        </HBox>
      <rowConstraints>
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
      </rowConstraints>

    </GridPane>


    <!-- ================= ANTENA ================= -->

    <GridPane fx:id="menuAntena" alignment="CENTER" hgap="12" styleClass="form-content" vgap="12">

        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" hgrow="NEVER" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="250" />
        </columnConstraints>

        <!-- Título -->
        <Label styleClass="primary-text" text="Crear antena" GridPane.columnSpan="2" />

        <!-- Prioridad -->
        <Label styleClass="secondary-text" text="Prioridad:" GridPane.rowIndex="1" />

        <TextField fx:id="txtAntennaPriority" styleClass="secondary-input" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <!-- Nombre -->
        <Label styleClass="secondary-text" text="Nombre:" GridPane.rowIndex="2" />

        <TextField fx:id="txtAntennaName" styleClass="secondary-input" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <!-- Sector -->
        <Label styleClass="secondary-text" text="Sector:" GridPane.rowIndex="3" />

        <ComboBox fx:id="cmbAntennaSector" styleClass="secondary-combo" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <!-- Imagen -->
        <Label styleClass="secondary-text" text="Imagen:" GridPane.rowIndex="4" />

        <VBox alignment="CENTER_LEFT" spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="4">

            <Button onAction="#selectAntennaImage" styleClass="tertiary-button" text="Seleccionar imagen" />

            <ImageView fx:id="imgAntennaPreview" fitHeight="100.0" fitWidth="150.0" preserveRatio="true" />
        </VBox>

        <!-- Estado -->
        <Label styleClass="secondary-text" text="Estado:" GridPane.rowIndex="5" />

        <ComboBox fx:id="cmbAntennaStatus" styleClass="secondary-combo" GridPane.columnIndex="1" GridPane.rowIndex="5" />

        <!-- Espacio -->
        <HBox GridPane.columnIndex="1" GridPane.rowIndex="6" />

        <!-- Reparación -->
        <CheckBox fx:id="chkForRepair" text="Requiere reparación" GridPane.columnIndex="1" GridPane.rowIndex="7" />

        <!-- Mantenimiento -->
        <CheckBox fx:id="chkForMaintenance" text="Requiere mantenimiento" GridPane.columnIndex="1" GridPane.rowIndex="8" />

        <!-- Días encendida -->
        <Label styleClass="secondary-text" text="Días encendida:" GridPane.rowIndex="9" />

        <TextField fx:id="txtCountDaysOn" styleClass="secondary-input" GridPane.columnIndex="1" GridPane.rowIndex="9" />

        <!-- Botones -->
        <HBox alignment="CENTER_RIGHT" spacing="12" GridPane.columnIndex="1" GridPane.rowIndex="10">

            <Button onAction="#createAntenna" styleClass="primary-button" text="Crear antena" />

            <Button onAction="#closeForm" styleClass="secondary-button" text="Cancelar" />
        </HBox>
      <rowConstraints>
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
      </rowConstraints>

    </GridPane>

    <GridPane fx:id="menuUserEdit" alignment="CENTER" hgap="12" styleClass="form-content" vgap="12">

        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" hgrow="NEVER" />
            <ColumnConstraints hgrow="ALWAYS" />
            <ColumnConstraints />
        </columnConstraints>

        <!-- Título -->
        <Label prefHeight="17.0" prefWidth="363.0" styleClass="primary-text" text="Editar usuario" GridPane.columnIndex="0" GridPane.columnSpan="2" />

        <!-- Nombre + Sector -->
        <Label styleClass="secondary-text" text="Nombre:" GridPane.rowIndex="2" />

        <HBox spacing="10" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="2">

            <TextField fx:id="txtUserNameEdit" prefHeight="25.0" prefWidth="70.0" promptText="Nombre" styleClass="secondary-input" HBox.hgrow="ALWAYS" />

            <Label styleClass="secondary-text" text="Sector:" />

            <ComboBox fx:id="cbxUserSectorEdit" prefHeight="25.0" prefWidth="120.0" promptText="Asignar Sector" styleClass="secondary-combo" />

        </HBox>

        <!-- Email -->
        <Label styleClass="secondary-text" text="Email:" GridPane.rowIndex="3" />

        <TextField fx:id="txtUserEmailEdit" promptText="Email" styleClass="secondary-input" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <!-- Rol -->
        <Label styleClass="secondary-text" text="Rol:" GridPane.rowIndex="4" />

        <ComboBox fx:id="cbxUserRoleEdit" promptText="Seleccionar rol" styleClass="secondary-combo" GridPane.columnIndex="1" GridPane.rowIndex="4" />

        <!-- Contraseña -->
        <Label styleClass="secondary-text" text="Contraseña:" GridPane.rowIndex="5" />

        <PasswordField fx:id="txtUserPasswordEdit" promptText="Nueva contraseña (opcional)" styleClass="secondary-input" GridPane.columnIndex="1" GridPane.rowIndex="5" />

        <!-- Imagen -->
        <Label styleClass="secondary-text" text="Imagen:" GridPane.rowIndex="6" />

        <Button onAction="#selectUserImage" styleClass="tertiary-button" text="Cambiar imagen de perfil" GridPane.columnIndex="1" GridPane.rowIndex="6" />

        <!-- Botones -->
        <HBox alignment="CENTER_RIGHT" spacing="12" GridPane.columnIndex="1" GridPane.rowIndex="7">

            <Button onAction="#editUser" styleClass="primary-button" text="Guardar cambios" />

            <Button onAction="#closeForm" styleClass="secondary-button" text="Cancelar" />

        </HBox>

        <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
        </rowConstraints>

    </GridPane>

    <GridPane fx:id="menuAppRename" alignment="CENTER" hgap="12" styleClass="form-content" vgap="12">

        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" hgrow="NEVER" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>
        <GridPane.margin>
            <Insets />
        </GridPane.margin>
        <!-- Título -->
        <VBox GridPane.columnIndex="1">
            <Label prefHeight="17.0"  styleClass="primary-text" text="Cambiar nombre de la aplicación"  />
            <Label fx:id="lblErrorRenameApp" text="Cambiar" visible="false" prefHeight="17.0"  styleClass="error_text"/>
        </VBox>
        <!-- Nuevo nombre -->
        <Label styleClass="secondary-text" text="Nuevo nombre:" GridPane.rowIndex="2" />

        <TextField fx:id="txtAppName" maxWidth="250.0" promptText="Ingrese el nuevo nombre" styleClass="secondary-input" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <!-- Contraseña -->
        <Label styleClass="secondary-text" text="Contraseña:" GridPane.rowIndex="3" />

        <PasswordField fx:id="txtAppPassword" maxWidth="250.0" promptText="Confirme su contraseña" styleClass="secondary-input" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <!-- Botones -->
        <HBox alignment="CENTER_RIGHT" spacing="12" GridPane.columnIndex="1" GridPane.rowIndex="4">

            <Button onAction="#renameApp" styleClass="primary-button" text="Guardar cambios" />

            <Button onAction="#closeForm" styleClass="secondary-button" text="Cancelar" />

        </HBox>

        <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
        </rowConstraints>

    </GridPane>

    <GridPane fx:id="menuAppChangeImage" alignment="CENTER" hgap="12" styleClass="form-content" vgap="12">

        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" hgrow="NEVER" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>

        <!-- Título -->
        <Label prefHeight="17.0" prefWidth="363.0" styleClass="primary-text" text="Cambiar imagen de la aplicación" GridPane.columnIndex="0" GridPane.columnSpan="2" />

        <!-- Imagen -->
        <Label styleClass="secondary-text" text="Nueva imagen:" GridPane.rowIndex="2" />

        <Button fx:id="btnAppImage" onAction="#selectAppImage" styleClass="tertiary-button" text="Seleccionar imagen" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <!-- Contraseña -->
        <Label styleClass="secondary-text" text="Contraseña:" GridPane.rowIndex="3" />

        <PasswordField fx:id="txtAppImagePassword" promptText="Confirme su contraseña" styleClass="secondary-input" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <!-- Botones -->
        <HBox alignment="CENTER_RIGHT" spacing="12" GridPane.columnIndex="1" GridPane.rowIndex="4">

            <Button onAction="#changeAppImage" styleClass="primary-button" text="Guardar cambios" />

            <Button onAction="#closeForm" styleClass="secondary-button" text="Cancelar" />

        </HBox>

        <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
        </rowConstraints>

    </GridPane>

    <GridPane fx:id="menuAppSecurity" alignment="CENTER" hgap="12" styleClass="form-content" vgap="12">

        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" hgrow="NEVER" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>

        <!-- Título -->
        <Label prefHeight="17.0" prefWidth="363.0" styleClass="primary-text" text="Seguridad de la aplicación" GridPane.columnIndex="0" GridPane.columnSpan="2" />

        <!-- Contraseña actual -->
        <Label styleClass="secondary-text" text="Contraseña actual:" GridPane.rowIndex="2" />

        <PasswordField fx:id="txtCurrentPassword" promptText="Contraseña actual" styleClass="secondary-input" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <!-- Nueva contraseña -->
        <Label styleClass="secondary-text" text="Nueva contraseña:" GridPane.rowIndex="3" />

        <PasswordField fx:id="txtNewPassword" promptText="Nueva contraseña" styleClass="secondary-input" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <!-- Confirmar -->
        <Label styleClass="secondary-text" text="Confirmar:" GridPane.rowIndex="4" />

        <PasswordField fx:id="txtConfirmPassword" promptText="Repita la nueva contraseña" styleClass="secondary-input" GridPane.columnIndex="1" GridPane.rowIndex="4" />

        <!-- Botones -->
        <HBox alignment="CENTER_RIGHT" spacing="12" GridPane.columnIndex="1" GridPane.rowIndex="5">

            <Button onAction="#changeAppSecurity" styleClass="primary-button" text="Guardar cambios" />

            <Button onAction="#closeForm" styleClass="secondary-button" text="Cancelar" />

        </HBox>

        <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
        </rowConstraints>

    </GridPane>

    <GridPane fx:id="menuAppSetting" alignment="CENTER" hgap="12" styleClass="form-content" vgap="12">

        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" hgrow="NEVER" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>

        <!-- Título -->
        <Label prefHeight="17.0" prefWidth="363.0" styleClass="primary-text" text="Configuración del aplicativo" GridPane.columnIndex="0" GridPane.columnSpan="2" />

        <!-- Tema -->
        <Label styleClass="secondary-text" text="Tema:" GridPane.rowIndex="2" />

        <ComboBox fx:id="cbxAppTheme" prefWidth="200.0" promptText="Seleccionar tema" styleClass="secondary-combo" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <!-- Inicio automático -->
        <Label styleClass="secondary-text" text="Inicio automático:" GridPane.rowIndex="3" />

        <CheckBox fx:id="chkAutoStart" styleClass="secondary-text" text="Iniciar con el sistema" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <!-- Notificaciones -->
        <Label styleClass="secondary-text" text="Notificaciones:" GridPane.rowIndex="4" />

        <CheckBox fx:id="chkNotifications" styleClass="secondary-text" text="Mostrar notificaciones" GridPane.columnIndex="1" GridPane.rowIndex="4" />

        <!-- Botones -->
        <HBox alignment="CENTER_RIGHT" spacing="12" GridPane.columnIndex="1" GridPane.rowIndex="5">

            <Button onAction="#saveAppSettings" styleClass="primary-button" text="Guardar cambios" />

            <Button onAction="#closeForm" styleClass="secondary-button" text="Cancelar" />

        </HBox>

        <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
        </rowConstraints>

    </GridPane>




