              GridPane.columnIndex="1"
              GridPane.rowIndex="9">

            <Button onAction="#createAntenna"
                    styleClass="primary-button"
                    text="Crear antena"/>

            <Button onAction="#closeForm"
                    styleClass="secondary-button"
                    text="Cancelar"/>
            <Button onAction="#clearForm"
                    styleClass="secondary-button"
                    text="Limpiar"/>
        </HBox>

        <rowConstraints>
            <RowConstraints/>
            <RowConstraints/>
            <RowConstraints/>
            <RowConstraints/>
            <RowConstraints/>
            <RowConstraints/>
            <RowConstraints/>
            <RowConstraints/>
            <RowConstraints/>
            <RowConstraints/>
        </rowConstraints>

