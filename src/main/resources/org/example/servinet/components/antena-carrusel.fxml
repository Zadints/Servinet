<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<VBox xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.servinet.ui.controllers.components.AntennaCarruselController"
            spacing="10"
            prefWidth="280"
            styleClass="admin-option"
            prefHeight="400.0">




        <StackPane>

            <ImageView
                    fx:id="imgAntenna1"
                    fitHeight="150"
                    fitWidth="250"
                    preserveRatio="true"/>

            <HBox alignment="TOP_RIGHT">

                <Pane HBox.hgrow="ALWAYS"/>

                <Button
                        onAction="#showAntennaOptions"
                        styleClass="tertiary-button"
                        text="⋮"/>

            </HBox>

        </StackPane>


        <HBox
                alignment="CENTER_LEFT"
                spacing="8">

            <VBox
                    spacing="3"
                    HBox.hgrow="ALWAYS">

                <Label
                        fx:id="lblAntennaName"
                        styleClass="admin-option-title"
                        text="Antena Central"/>

                <Label
                        fx:id="lblAntennaLocate"
                        styleClass="tertiary-text"
                        text="Zona Centro"/>

            </VBox>

            <Label
                    fx:id="lblAntennaStatus"
                    styleClass="quaternary-text"
                    text="ACTIVA"/>

        </HBox>


        <HBox spacing="8">

            <Label
                    styleClass="secondary-text"
                    text="Clientes:"/>

            <Label
                    fx:id="lblClientsAntenna"
                    styleClass="primary-text"
                    text="42"/>

        </HBox>


        <HBox spacing="8">

            <Button
                    onAction="#startMaintenance"
                    styleClass="secondary-button"
                    text="Activar Mantenimiento"
                    HBox.hgrow="ALWAYS"
                    maxWidth="Infinity"/>

            <Button
                    onAction="#toggleAntenna"
                    styleClass="secondary-button"
                    text="Desactivar"
                    HBox.hgrow="ALWAYS"
                    maxWidth="Infinity"/>

        </HBox>



</VBox>
