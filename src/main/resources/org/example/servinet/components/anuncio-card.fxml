<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12"
      styleClass="admin-option"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.servinet.ui.controllers.components.AnnuncioCardController">

    <HBox alignment="CENTER_LEFT" spacing="10">

        <VBox spacing="2">
            <Label fx:id="lblAutor" styleClass="secondary-text" text="Autor"/>
            <Label fx:id="lblFecha" styleClass="quaternary-text" text="Fecha"/>
        </VBox>

        <Pane HBox.hgrow="ALWAYS"/>

        <Label fx:id="lblPrioridad" text="Media"/>

    </HBox>

    <Label fx:id="lblTitulo" styleClass="primary-text" text="Título"/>

    <Label fx:id="lblContenido" styleClass="tertiary-text" wrapText="true" text="Contenido"/>

    <StackPane fx:id="mediaContainer" maxWidth="Infinity"/>

    <HBox alignment="CENTER_LEFT" spacing="15">

        <Button fx:id="btnLike" onAction="#onLikeClicked" styleClass="tertiary-button" text="👍 0"/>

        <Button fx:id="btnComentarios" onAction="#onToggleComments" styleClass="tertiary-button" text="💬 0"/>

        <Pane HBox.hgrow="ALWAYS"/>

        <Button fx:id="btnEditar" onAction="#editarAnuncio" styleClass="secondary-button" text="Editar"/>

        <Button fx:id="btnEliminar" onAction="#eliminarAnuncio" styleClass="tertiary-button" text="Eliminar"/>

    </HBox>

    <VBox fx:id="commentsPanel" managed="false" spacing="8" visible="false">

        <VBox fx:id="commentsList" spacing="6"/>

        <HBox alignment="CENTER" spacing="8">

            <TextField fx:id="txtNewComment"
                       onAction="#onAddComment"
                       promptText="Escribe un comentario..."
                       styleClass="secondary-input"
                       HBox.hgrow="ALWAYS"/>

            <Button onAction="#onAddComment" styleClass="primary-button" text="Enviar"/>

        </HBox>

    </VBox>

</VBox>
