<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.shape.Circle?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="CONTROLLER_NAME"
            prefHeight="400.0" prefWidth="600.0">
    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="user-row">

        <Circle radius="22" styleClass="user-image" />

        <VBox spacing="3" HBox.hgrow="ALWAYS">

            <Label styleClass="user-name" text="Cesar Augusto" />

            <Label styleClass="user-email" text="cesar@email.com" />

        </VBox>

        <Label styleClass="user-role" text="ADMIN" />

        <Button styleClass="edit-button" text="Editar" />

        <Button styleClass="delete-button" text="Eliminar" />

    </HBox>
</AnchorPane>
