<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.servinet.ui.controllers.components.ClienteRowController">

    <HBox
            alignment="CENTER_LEFT"
            spacing="12"
            styleClass="user-row"
            AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0"
            AnchorPane.topAnchor="0.0"
            AnchorPane.bottomAnchor="0.0">

        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label fx:id="lblClientName" styleClass="primary-text" text="Nombre Apellido"/>
            <Label fx:id="lblClientPhonePlan" styleClass="secondary-text" text="987654321 • Plan"/>
            <Label fx:id="lblClientZoneAddress" styleClass="quaternary-text" text="• Dirección" wrapText="true"/>
        </VBox>

        <VBox fx:id="clientStatusBox" spacing="3" alignment="CENTER_RIGHT" prefWidth="100">
            <Label styleClass="secondary-text" text="Estado"/>
            <Label fx:id="lblClientStatus" styleClass="quaternary-text" text="ACTIVO"/>
        </VBox>

        <VBox fx:id="clientPaymentBox" spacing="3" alignment="CENTER_RIGHT" prefWidth="110">
            <Label styleClass="secondary-text" text="Pago"/>
            <Label fx:id="lblClientPaymentStatus" styleClass="payment-paid" text="AL DÍA"/>
        </VBox>

        <Button fx:id="btnClientInfo"
                onAction="#onInfoClick"
                styleClass="secondary-button"
                text="Más información"/>

        <Button fx:id="btnClientPayments"
                onAction="#onPaymentsClick"
                styleClass="secondary-button"
                text="Pagos"/>

        <Button fx:id="btnClientCopy"
                onAction="#onCopyClick"
                styleClass="secondary-button"
                text="Copiar perfil"/>

        <Button fx:id="btnClientEdit"
                onAction="#onEditClick"
                styleClass="tertiary-button"
                text="Editar"/>

        <Button fx:id="btnClientDelete"
                onAction="#onDeleteClick"
                styleClass="tertiary-button"
                text="Eliminar"/>

    </HBox>

</AnchorPane>