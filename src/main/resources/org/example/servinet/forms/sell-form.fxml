<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane
        fx:id="mainSell"
        styleClass="form-content"
        xmlns="http://javafx.com/javafx/17.0.12"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.example.servinet.ui.controllers.forms.VentasFormController">

    <ScrollPane
            fitToWidth="true"
            hbarPolicy="NEVER"
            styleClass="transparent-scroll"
            vbarPolicy="AS_NEEDED"
            AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0"
            AnchorPane.topAnchor="0.0">

        <VBox fillWidth="true" spacing="20" style="-fx-padding: 20px;">

            <!-- ================================================= -->
            <!-- TÍTULO -->
            <!-- ================================================= -->

            <VBox spacing="3">
                <Label styleClass="content-title" text="Nuevo Contrato"/>
                <Label styleClass="tertiary-text"
                       text="Registra un nuevo cliente y configura el contrato de servicio de internet."/>
            </VBox>


            <!-- ================================================= -->
            <!-- DATOS DEL CLIENTE -->
            <!-- ================================================= -->

            <VBox spacing="15" styleClass="admin-option">

                <VBox spacing="3">
                    <Label styleClass="primary-text" text="Datos del cliente"/>
                    <Label styleClass="tertiary-text" text="Información necesaria para registrar al cliente."/>
                </VBox>

                <GridPane hgap="15" vgap="12">

                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" hgrow="NEVER"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="250"/>
                        <ColumnConstraints halignment="RIGHT" hgrow="NEVER"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="250"/>
                    </columnConstraints>

                    <!-- FILA 0: NOMBRE / APELLIDO -->

                    <Label styleClass="secondary-text" text="Nombre"
                           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtNombre" promptText="Nombres del cliente"
                               styleClass="secondary-input" maxWidth="Infinity"
                               GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label styleClass="secondary-text" text="Apellido"
                           GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtApellido" promptText="Apellidos del cliente"
                               styleClass="secondary-input" maxWidth="Infinity"
                               GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                    <!-- FILA 1: TELÉFONO / DNI -->

                    <Label styleClass="secondary-text" text="Teléfono"
                           GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtTelefono" promptText="Número de teléfono"
                               styleClass="secondary-input" maxWidth="Infinity"
                               GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label styleClass="secondary-text" text="DNI"
                           GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtDni" promptText="8 dígitos"
                               styleClass="secondary-input" maxWidth="Infinity"
                               GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                    <!-- FILA 2: DIRECCIÓN / EMAIL -->

                    <Label styleClass="secondary-text" text="Dirección"
                           GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtDireccion" promptText="Barrio, sector o zona"
                               styleClass="secondary-input" maxWidth="Infinity"
                               GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <Label styleClass="secondary-text" text="Email"
                           GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtEmail" promptText="correo@ejemplo.com"
                               styleClass="secondary-input" maxWidth="Infinity"
                               GridPane.columnIndex="3" GridPane.rowIndex="2"/>

                    <!-- FILA 3: WHATSAPP -->

                    <Label styleClass="secondary-text" text="WhatsApp"
                           GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <TextField fx:id="txtWhatsapp" promptText="Número de WhatsApp"
                               styleClass="secondary-input" maxWidth="Infinity"
                               GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                </GridPane>

            </VBox>


            <!-- ================================================= -->
            <!-- SERVICIO -->
            <!-- ================================================= -->

            <VBox spacing="15" styleClass="admin-option">

                <VBox spacing="3">
                    <Label styleClass="primary-text" text="Servicio de internet"/>
                    <Label styleClass="tertiary-text"
                           text="Selecciona el plan y la antena que tendrá asignado el cliente."/>
                </VBox>

                <VBox spacing="15" maxWidth="Infinity">

                    <VBox spacing="5">
                        <Label styleClass="secondary-text" text="Plan del usuario"/>
                        <ComboBox fx:id="cmbPlan" maxWidth="Infinity"
                                  promptText="Seleccionar plan" styleClass="secondary-combo"/>
                    </VBox>

                    <VBox spacing="5">
                        <Label styleClass="secondary-text" text="Antena con menos conexiones"/>
                        <ComboBox fx:id="cmbAntenna" maxWidth="Infinity"
                                  promptText="Seleccionar antena" styleClass="secondary-combo"/>
                    </VBox>

                </VBox>

            </VBox>


            <!-- ================================================= -->
            <!-- RESUMEN -->
            <!-- ================================================= -->

            <VBox spacing="12" styleClass="admin-option">

                <Label styleClass="primary-text" text="Resumen de la venta"/>

                <HBox spacing="30">

                    <VBox spacing="3">
                        <Label styleClass="quaternary-text" text="Cliente"/>
                        <Label fx:id="lblSummaryClient" styleClass="primary-text" text="Sin seleccionar"/>
                    </VBox>

                    <VBox spacing="3">
                        <Label styleClass="quaternary-text" text="Plan"/>
                        <Label fx:id="lblSummaryPlan" styleClass="primary-text" text="Sin seleccionar"/>
                    </VBox>

                    <VBox spacing="3">
                        <Label styleClass="quaternary-text" text="Monto"/>
                        <Label fx:id="lblSummaryAmount" styleClass="primary-text" text="S/ 0.00"/>
                    </VBox>

                </HBox>

            </VBox>


            <!-- ================================================= -->
            <!-- BOTONES -->
            <!-- ================================================= -->

            <HBox alignment="CENTER_RIGHT" spacing="10">

                <Button fx:id="btnClose" onAction="#closeForm"
                        styleClass="secondary-button" text="Cancelar"/>

                <Button fx:id="btnCreateClient" onAction="#registerSale"
                        styleClass="primary-button" text="Crear contrato y enviar comprobante"/>

            </HBox>

        </VBox>

    </ScrollPane>

</AnchorPane>