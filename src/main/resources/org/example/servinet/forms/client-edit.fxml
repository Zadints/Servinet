<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            fx:id="menuClientEdit"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.servinet.ui.controllers.forms.ClientEditController"
            styleClass="form-content"
      >

    <GridPane
              alignment="CENTER"
              hgap="12"
              vgap="12"
              AnchorPane.topAnchor="20.0"
              AnchorPane.bottomAnchor="20.0"
              AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0">

        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" hgrow="NEVER"/>
            <ColumnConstraints halignment="LEFT" hgrow="ALWAYS"/>
        </columnConstraints>

        <VBox alignment="CENTER"
              spacing="10"
              GridPane.columnIndex="0"
              GridPane.columnSpan="2"
              maxWidth="Infinity">

            <Label text="Editar cliente"
                   styleClass="primary-text"
                   alignment="CENTER"
                   maxWidth="Infinity"/>

            <Label fx:id="lblErrorEditClient"
                   alignment="CENTER"
                   text=""
                   maxWidth="Infinity"
                   visible="false"
                   managed="false"
                   prefHeight="17.0"
                   styleClass="error_text"/>
        </VBox>

        <Label text="Nombres:"
               styleClass="secondary-text"
               GridPane.rowIndex="1"
               GridPane.halignment="RIGHT"/>

        <TextField fx:id="txtClientFirstNameEdit"
                   promptText="Nombres"
                   styleClass="secondary-input"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="1"
                   GridPane.hgrow="ALWAYS"
                   disable="true"/>

        <Label text="Apellidos:"
               styleClass="secondary-text"
               GridPane.rowIndex="2"
               GridPane.halignment="RIGHT"/>

        <TextField fx:id="txtClientLastNameEdit"
                   promptText="Apellidos"
                   styleClass="secondary-input"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="2"
                   GridPane.hgrow="ALWAYS"
                   disable="true"/>

        <Label text="DNI:"
               styleClass="secondary-text"
               GridPane.rowIndex="3"
               GridPane.halignment="RIGHT"/>

        <TextField fx:id="txtClientDniEdit"
                   promptText="8 dígitos"
                   styleClass="secondary-input"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="3"
                   GridPane.hgrow="ALWAYS"
                   disable="true"/>

        <Label text="Teléfono:"
               styleClass="secondary-text"
               GridPane.rowIndex="4"
               GridPane.halignment="RIGHT"/>

        <TextField fx:id="txtClientPhoneEdit"
                   promptText="Celular de contacto"
                   styleClass="secondary-input"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="4"
                   GridPane.hgrow="ALWAYS"/>

        <Label text="Correo:"
               styleClass="secondary-text"
               GridPane.rowIndex="5"
               GridPane.halignment="RIGHT"/>

        <TextField fx:id="txtClientEmailEdit"
                   promptText="Opcional"
                   styleClass="secondary-input"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="5"
                   GridPane.hgrow="ALWAYS"/>

        <Label text="Dirección:"
               styleClass="secondary-text"
               GridPane.rowIndex="6"
               GridPane.halignment="RIGHT"/>

        <TextField fx:id="txtClientAddressEdit"
                   promptText="Dirección de instalación"
                   styleClass="secondary-input"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="6"
                   GridPane.hgrow="ALWAYS"/>

        <Label text="Plan:"
               styleClass="secondary-text"
               GridPane.rowIndex="7"
               GridPane.halignment="RIGHT"/>

        <ComboBox fx:id="cbxClientPlanEdit"
                  styleClass="secondary-input"
                  maxWidth="Infinity"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="7"
                  GridPane.hgrow="ALWAYS"/>

        <Label text="Número de WhatsApp:"
               styleClass="secondary-text"
               GridPane.rowIndex="8"
               GridPane.halignment="RIGHT"/>

        <TextField fx:id="txtClientNumWhatsApp"
                   styleClass="secondary-date-picker"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="8"
                   GridPane.hgrow="ALWAYS"/>

        <HBox alignment="CENTER"
              spacing="12"
              GridPane.columnIndex="0"
              GridPane.columnSpan="2"
              GridPane.rowIndex="9">

            <Button onAction="#saveEditClient"
                    styleClass="primary-button"
                    text="Guardar cambios"/>

            <Button fx:id="btnClose"
                    onAction="#closeForm"
                    styleClass="secondary-button"
                    text="Cancelar"/>
        </HBox>

    </GridPane>
</AnchorPane>
