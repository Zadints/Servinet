<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>


<ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;"
            xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.servinet.controllers.center.DashboardController">


    <VBox spacing="30.0" style="-fx-padding: 30;">


        <HBox alignment="CENTER_LEFT">
            <Label text="Dashboard" style="-fx-font-family: 'Poppins'; -fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #333333;" />
            <Pane HBox.hgrow="ALWAYS" />
            <Button text="Crear Backup" style="-fx-background-color: #00A6FF; -fx-text-fill: white; -fx-font-family: 'Poppins'; -fx-font-weight: bold; -fx-padding: 8 20 8 20; -fx-background-radius: 20; -fx-cursor: hand;" />
        </HBox>


        <HBox spacing="20.0">

            <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);" HBox.hgrow="ALWAYS">
                <Label text="Clientes Activos" style="-fx-text-fill: #888888; -fx-font-size: 14px; -fx-font-family: 'Poppins';" />
                <Label text="1,245" style="-fx-text-fill: #333333; -fx-font-size: 32px; -fx-font-weight: bold; -fx-font-family: 'Poppins';" />
            </VBox>


            <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);" HBox.hgrow="ALWAYS">
                <Label text="Antenas en Línea" style="-fx-text-fill: #888888; -fx-font-size: 14px; -fx-font-family: 'Poppins';" />
                <Label text="34 / 35" style="-fx-text-fill: #00C851; -fx-font-size: 32px; -fx-font-weight: bold; -fx-font-family: 'Poppins';" />
            </VBox>


            <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);" HBox.hgrow="ALWAYS">
                <Label text="Problemas Reportados" style="-fx-text-fill: #888888; -fx-font-size: 14px; -fx-font-family: 'Poppins';" />
                <Label text="12" style="-fx-text-fill: #ff4444; -fx-font-size: 32px; -fx-font-weight: bold; -fx-font-family: 'Poppins';" />
            </VBox>
        </HBox>


        <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);" prefHeight="400.0">
            <Label text="Últimos Pagos Registrados" style="-fx-text-fill: #333333; -fx-font-size: 18px; -fx-font-weight: bold; -fx-font-family: 'Poppins';" />

            <Label text="(Aquí irá la tabla de clientes próximamente...)" style="-fx-text-fill: #aaaaaa; -fx-padding: 50 0 0 0;" />
        </VBox>

    </VBox>
</ScrollPane>