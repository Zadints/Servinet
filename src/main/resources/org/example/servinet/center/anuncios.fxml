<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.shape.Circle?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<AnchorPane
        styleClass="content-style"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.example.servinet.ui.controllers.center.AnunciosController">

    <GridPane
            hgap="20"
            vgap="20"
            style="-fx-padding: 20px;"
            AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0"
            AnchorPane.topAnchor="0.0">

        <columnConstraints>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <rowConstraints>
            <RowConstraints vgrow="NEVER"/>
            <RowConstraints vgrow="ALWAYS"/>
        </rowConstraints>

        <children>

            <!-- ================================================= -->
            <!-- ENCABEZADO -->
            <!-- ================================================= -->

            <HBox alignment="CENTER_LEFT"
                  spacing="15"
                  GridPane.columnIndex="0"
                  GridPane.rowIndex="0">

                <VBox spacing="3">

                    <Label styleClass="content-title"
                           text="Anuncios"/>

                    <Label styleClass="tertiary-text"
                           text="Novedades, avisos y comunicados"/>

                </VBox>

                <Pane HBox.hgrow="ALWAYS"/>

                <ComboBox fx:id="cbxPriorityFilter"
                          promptText="Prioridad"
                          styleClass="secondary-combo"/>

                <Button fx:id="btnCreateAnnounce"
                        onAction="#createAnnounce"
                        styleClass="primary-button"
                        text="+ Crear anuncio"/>

            </HBox>


            <!-- ================================================= -->
            <!-- FEED -->
            <!-- ================================================= -->

            <StackPane GridPane.columnIndex="0"
                       GridPane.rowIndex="1"
                       VBox.vgrow="ALWAYS">

                <ScrollPane fitToWidth="true"
                            styleClass="users-scroll">

                    <VBox fx:id="anunciosContainer"
                          spacing="15"
                          styleClass="users-list"/>

                </ScrollPane>

                <StackPane fx:id="loadingOverlay"
                           style="-fx-background-color: #FFFFFFF2; -fx-background-radius: 15;">

                    <VBox alignment="CENTER"
                          spacing="15">

                        <StackPane prefWidth="70"
                                   prefHeight="70">

                            <Circle fx:id="loadingCircle"
                                    radius="28"
                                    fill="transparent"
                                    stroke="#22A5F1"
                                    strokeWidth="3"/>

                            <FontIcon iconLiteral="fas-wifi"
                                      iconSize="20"
                                      iconColor="#22A5F1"/>

                        </StackPane>

                        <Label fx:id="lblLoading"
                               text="Verificando sesión de dispositivo..."
                               styleClass="secondary-text"/>

                        <Label text="Por favor espera un momento"
                               styleClass="quaternary-text"/>

                    </VBox>

                </StackPane>

            </StackPane>


        </children>

    </GridPane>

</AnchorPane>