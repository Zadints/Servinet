<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import javafx.scene.shape.Circle?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<AnchorPane
        styleClass="content-style"
        xmlns="http://javafx.com/javafx/17.0.12"    
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.example.servinet.ui.controllers.center.ClientesController">

    <GridPane
            hgap="20"
            vgap="20"
            style="-fx-padding: 20px;"
            AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0"
            AnchorPane.topAnchor="0.0">

        <columnConstraints>
            <ColumnConstraints
                    hgrow="ALWAYS"
                    maxWidth="613.0"
                    minWidth="360.0"
                    prefWidth="613.0"/>

            <ColumnConstraints
                    hgrow="ALWAYS"
                    maxWidth="766.0"
                    minWidth="513.0"
                    prefWidth="513.0"/>
        </columnConstraints>

        <rowConstraints>
            <RowConstraints
                    minHeight="10.0"
                    prefHeight="30.0"
                    vgrow="NEVER"/>

            <RowConstraints
                    vgrow="NEVER"/>

            <RowConstraints
                    vgrow="ALWAYS"/>
        </rowConstraints>

        <children>

            <HBox
                    alignment="CENTER_LEFT"
                    spacing="15"
                    GridPane.columnIndex="0"
                    GridPane.columnSpan="2">

                <VBox spacing="3">

                    <Label
                            styleClass="content-title"
                            text="Clientes"/>

                    <Label
                            styleClass="tertiary-text"
                            text="Administra la información y actividad de los clientes."/>

                </VBox>

                <Pane HBox.hgrow="ALWAYS"/>

                <!--
                <Button fx:id="btnRefreshClients"
                        onAction="#refreshNowClients"
                        styleClass="tertiary-button"
                        text="Actualizar"/>
-->
            </HBox>


            <VBox fx:id="sectionPaymentSummary"
                    spacing="15"
                    GridPane.columnIndex="0"
                    GridPane.columnSpan="2"
                    GridPane.rowIndex="1">

                <HBox fx:id="rankingHeader"
                        alignment="CENTER_LEFT"
                        spacing="10">

                    <VBox
                            spacing="3"
                            HBox.hgrow="ALWAYS">

                        <Label
                                styleClass="primary-text"
                                text="Comportamiento de clientes"/>

                        <Label
                                fx:id="lblRankingDescription"
                                styleClass="tertiary-text"
                                text="Clientes con mejor comportamiento de pago."/>

                    </VBox>

                    <Button
                            fx:id="btnChangeRanking"
                            onAction="#changeRanking"
                            styleClass="secondary-button"
                            text="Ver irresponsables"/>

                </HBox>


                <HBox spacing="15">


                    <VBox
                            spacing="8"
                            styleClass="admin-option"
                            HBox.hgrow="ALWAYS">

                        <HBox
                                alignment="CENTER_LEFT"
                                spacing="10">

                            <VBox fx:id="rankingClientCard"
                                    spacing="3"
                                    HBox.hgrow="ALWAYS">

                                <Label
                                        styleClass="secondary-text"
                                        text="#1 Cliente"/>

                                <Label
                                        fx:id="lblTopClientName"
                                        styleClass="primary-text"
                                        text="Juan Pérez"/>

                            </VBox>

                            <Label
                                    fx:id="lblTopClientScore"
                                    styleClass="primary-text"
                                    text="98%"/>

                        </HBox>

                        <Label
                                fx:id="lblTopClientDescription"
                                styleClass="tertiary-text"
                                text="Pagos realizados puntualmente."
                                wrapText="true"/>

                    </VBox>



                    <VBox
                            spacing="8"
                            styleClass="admin-option"
                            HBox.hgrow="ALWAYS">

                        <Label
                                styleClass="secondary-text"
                                text="Resumen"/>

                        <HBox spacing="25">

                            <VBox spacing="3">

                                <Label
                                        styleClass="quaternary-text"
                                        text="Clientes"/>

                                <Label
                                        fx:id="lblTotalClients"
                                        styleClass="primary-text"
                                        text="0"/>

                            </VBox>

                            <VBox spacing="3">

                                <Label
                                        styleClass="quaternary-text"
                                        text="Al día"/>

                                <Label
                                        fx:id="lblClientsUpToDate"
                                        styleClass="primary-text"
                                        text="0"/>

                            </VBox>

                            <VBox spacing="3">

                                <Label
                                        styleClass="quaternary-text"
                                        text="Pendientes"/>

                                <Label
                                        fx:id="lblClientsPending"
                                        styleClass="primary-text"
                                        text="0"/>

                            </VBox>

                        </HBox>

                    </VBox>

                </HBox>

            </VBox>


            <!-- LISTA DE CLIENTES -->
            <VBox fx:id="clientsSection"
                    spacing="15"
                    GridPane.columnIndex="0"
                    GridPane.columnSpan="2"
                    GridPane.rowIndex="2">

                <!-- CABECERA -->
                <HBox
                        alignment="CENTER_LEFT"
                        spacing="10">

                    <VBox
                            spacing="3"
                            HBox.hgrow="ALWAYS">

                        <Label
                                styleClass="primary-text"
                                text="Clientes registrados"/>

                        <Label
                                styleClass="tertiary-text"
                                text="Consulta y administra los clientes registrados en el sistema."/>

                    </VBox>

                </HBox>


                <!-- BUSCADOR -->
                <HBox fx:id="searchControls"
                        spacing="10"
                        alignment="CENTER_LEFT">

                    <ComboBox
                            fx:id="cmbSearchType"
                            prefWidth="150"
                            styleClass="secondary-combo">

                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="Dni"/>
                                <String fx:value="Nombre"/>
                                <String fx:value="Apellido"/>
                                <String fx:value="Direccion"/>
                                <String fx:value="Telefono"/>
                                <String fx:value="Whatsapp"/>
                                <String fx:value="Plan"/>
                            </FXCollections>
                        </items>

                    </ComboBox>

                    <TextField
                            fx:id="txtSearchClient"
                            promptText="Buscar cliente..."
                            styleClass="secondary-input"
                            HBox.hgrow="ALWAYS"/>

                    <Button
                            fx:id="btnSearchClient"
                            onAction="#searchClients"
                            styleClass="secondary-button"
                            text="Buscar"/>

                    <Button
                            fx:id="btnClearSearch"
                            onAction="#clearSearch"
                            styleClass="tertiary-button"
                            text="Limpiar"/>

                </HBox>


                <!-- LISTA -->
                <StackPane VBox.vgrow="ALWAYS">

                    <!-- Lista de clientes -->
                    <ScrollPane
                            fitToWidth="true"
                            hbarPolicy="NEVER"
                            styleClass="users-scroll"
                            vbarPolicy="AS_NEEDED">

                        <VBox
                                fx:id="clientsList"
                                fillWidth="true"
                                spacing="8"
                                styleClass="users-list">
                        </VBox>

                    </ScrollPane>

                    <!-- Overlay de carga -->
                    <StackPane
                            fx:id="loadingOverlay"
                            visible="false"
                            managed="false"
                            style="-fx-background-color: #FFFFFFF2; -fx-background-radius: 15;">

                        <VBox alignment="CENTER"
                              spacing="15">

                            <StackPane prefWidth="70"
                                       prefHeight="70">

                                <Circle fx:id="loadingCircle"
                                        radius="28"
                                        fill="transparent"
                                        stroke="#22A5F1"
                                        strokeWidth="3"/>

                                <FontIcon iconLiteral="fas-wifi"
                                          iconSize="20"
                                          iconColor="#22A5F1"/>

                            </StackPane>

                            <Label fx:id="lblLoading"
                                   text="Cargando clientes..."
                                   styleClass="secondary-text"/>

                            <Label text="Por favor espera un momento"
                                   styleClass="quaternary-text"/>

                        </VBox>

                    </StackPane>

                </StackPane>

            </VBox>

        </children>

    </GridPane>

</AnchorPane>