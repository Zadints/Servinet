<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<AnchorPane
        styleClass="content-style"
        xmlns="http://javafx.com/javafx/17.0.12"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.example.servinet.ui.controllers.center.AdministrationController">


    <!-- SCROLL GENERAL DE ADMINISTRACIÓN -->


    <ScrollPane
            fitToWidth="true"
            hbarPolicy="NEVER"
            styleClass="transparent-scroll"
            vbarPolicy="AS_NEEDED"
            AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0"
            AnchorPane.topAnchor="0.0">

        <VBox
                fillWidth="true"
                spacing="20"
                style="-fx-padding: 20px;">


            <!-- TÍTULO -->


            <Label
                    prefHeight="17.0"
                    prefWidth="330.0"
                    styleClass="content-title"
                    text="Administración"/>



            <!-- ===================== GESTIÓN DE USUARIOS ===================== -->

            <VBox spacing="12">

                <!-- CABECERA -->

                <HBox
                        alignment="CENTER_LEFT"
                        spacing="10">

                    <VBox spacing="3">

                        <Label
                                text="Usuarios registrados"
                                styleClass="primary-text"/>

                        <Label
                                text="Administra los usuarios y organízalos según el rol asignado."
                                styleClass="secondary-text"/>

                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button
                            fx:id="btnCreateUser"
                            text="Crear usuario"
                            onAction="#userCreate"
                            styleClass="primary-button"/>

                </HBox>


                <!-- FILTROS -->

                <HBox
                        alignment="CENTER_LEFT"
                        spacing="10"
                        styleClass="admin-users-toolbar">

                    <TextField
                            fx:id="txtUserSearch"
                            prefWidth="280"
                            promptText="Buscar por nombre o correo..."
                            styleClass="secondary-input"/>

                    <ComboBox
                            fx:id="cmbRoleFilter"
                            prefWidth="190"
                            promptText="Todos los roles"
                            styleClass="secondary-combo"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label
                            fx:id="lblUsersSummary"
                            text="0 usuarios"
                            styleClass="secondary-text"/>

                </HBox>


                <!-- USUARIOS AGRUPADOS POR ROL -->

                <ScrollPane
                        fitToWidth="true"
                        hbarPolicy="NEVER"
                        prefHeight="430"
                        styleClass="users-scroll"
                        vbarPolicy="AS_NEEDED">

                    <VBox
                            fx:id="usersList"
                            fillWidth="true"
                            spacing="15"
                            styleClass="users-list"/>

                </ScrollPane>

            </VBox>



            <!-- ACTIVIDAD DEL USUARIO -->


            <VBox
                    spacing="20"
                    styleClass="users-list">

                <HBox
                        alignment="CENTER_LEFT"
                        spacing="20">

                    <VBox
                            spacing="3"
                            HBox.hgrow="ALWAYS"
                            styleClass="pb-30">

                        <Label
                                styleClass="primary-text"
                                text="Actividad del usuario"/>

                        <Label
                                styleClass="secondary-text"
                                text="Consulta la actividad reciente de un usuario."/>

                    </VBox>

                    <ComboBox
                            fx:id="cmbActivityUser"
                            prefWidth="160"
                            promptText="Seleccionar usuario"
                            styleClass="secondary-combo"/>

                </HBox>


                <!-- ACTIVIDAD TIPO GITHUB -->

                <HBox
                        spacing="40"
                        styleClass="pl-30">

                    <Label
                            styleClass="tertiary-text"
                            text="Ene"/>

                    <Label
                            styleClass="tertiary-text"
                            text="Feb"/>

                    <Label
                            styleClass="tertiary-text"
                            text="Mar"/>

                    <Label
                            styleClass="tertiary-text"
                            text="Abr"/>

                    <Label
                            styleClass="tertiary-text"
                            text="May"/>

                    <Label
                            styleClass="tertiary-text"
                            text="Jun"/>

                    <Label
                            styleClass="tertiary-text"
                            text="Jul"/>

                    <Label
                            styleClass="tertiary-text"
                            text="Ago"/>

                </HBox>


                <HBox
                        alignment="CENTER_LEFT"
                        spacing="10">

                    <VBox spacing="25">

                        <Label
                                styleClass="tertiary-text"
                                text="Lun"/>

                        <Label
                                styleClass="tertiary-text"
                                text="Mar"/>

                        <Label
                                styleClass="tertiary-text"
                                text="Vier"/>

                    </VBox>

                    <GridPane
                            fx:id="activityGrid"
                            hgap="4"
                            vgap="4"
                            HBox.hgrow="ALWAYS"/>

                </HBox>


                <!-- LEYENDA -->

                <HBox
                        alignment="CENTER_LEFT"
                        spacing="6">

                    <Label
                            styleClass="tertiary-text"
                            text="Actividad"/>

                    <Region prefWidth="5"/>

                    <Region
                            prefHeight="12"
                            prefWidth="12"
                            styleClass="activity-level-0"/>

                    <Region
                            prefHeight="12"
                            prefWidth="12"
                            styleClass="activity-level-1"/>

                    <Region
                            prefHeight="12"
                            prefWidth="12"
                            styleClass="activity-level-2"/>

                    <Region
                            prefHeight="12"
                            prefWidth="12"
                            styleClass="activity-level-3"/>

                    <Region
                            prefHeight="12"
                            prefWidth="12"
                            styleClass="activity-level-4"/>

                </HBox>


                <!-- BOTÓN -->

                <Button
                        maxWidth="Infinity"
                        styleClass="secondary-button"
                        onAction="#viewLogs"
                        text="Ver logs"/>

            </VBox>


            <!-- OPCIONES DEL PROPIETARIO -->


            <VBox spacing="15">

                <Label
                        styleClass="primary-text"
                        text="Opciones del propietario"/>

                <Label
                        styleClass="tertiary-text"
                        text="Configuración general y control de la aplicación."
                        wrapText="true"/>


                <GridPane
                        hgap="12"
                        maxWidth="Infinity"
                        vgap="12">

                    <columnConstraints>

                        <ColumnConstraints
                                percentWidth="25"
                                hgrow="ALWAYS"/>

                        <ColumnConstraints
                                percentWidth="25"
                                hgrow="ALWAYS"/>

                        <ColumnConstraints
                                percentWidth="25"
                                hgrow="ALWAYS"/>

                        <ColumnConstraints
                                percentWidth="25"
                                hgrow="ALWAYS"/>

                    </columnConstraints>



                    <!-- NOMBRE DE LA APP -->


                    <VBox
                            fx:id="optName"
                            maxHeight="Infinity"
                            maxWidth="Infinity"
                            spacing="10"
                            styleClass="admin-option">

                        <Label
                                styleClass="admin-option-title"
                                text="Nombre de la aplicación"/>

                        <Label
                                styleClass="admin-option-description"
                                text="Cambia el nombre que se muestra en la aplicación."
                                wrapText="true"/>

                        <Button
                                maxWidth="Infinity"
                                styleClass="admin-button"
                                onAction="#appRename"
                                text="Cambiar nombre"/>

                    </VBox>



                    <!-- IMAGEN -->


                    <VBox
                            fx:id="optLogo"
                            maxHeight="Infinity"
                            maxWidth="Infinity"
                            spacing="10"
                            styleClass="admin-option"
                            GridPane.columnIndex="1">

                        <Label
                                styleClass="admin-option-title"
                                text="Imagen de la aplicación"/>

                        <Label
                                styleClass="admin-option-description"
                                text="Cambia el logo de la aplicación."
                                wrapText="true"/>

                        <Button
                                maxWidth="Infinity"
                                styleClass="admin-button"
                                onAction="#appChangeLogo"
                                text="Cambiar imagen"/>

                    </VBox>



                    <!-- SEGURIDAD -->


                    <VBox
                            fx:id="optSecurity"
                            maxHeight="Infinity"
                            maxWidth="Infinity"
                            spacing="10"
                            styleClass="admin-option"
                            GridPane.columnIndex="2">

                        <Label
                                styleClass="admin-option-title"
                                text="Seguridad de cuentas"/>

                        <Label
                                styleClass="admin-option-description"
                                text="Administra el sistema de seguridad general."
                                wrapText="true"/>

                        <Button
                                maxWidth="Infinity"
                                styleClass="admin-button"
                                onAction="#appSecurity"
                                text="Gestionar seguridad"/>

                    </VBox>



                    <!-- CONFIGURACIÓN -->


                    <VBox
                            fx:id="optConfig"
                            maxHeight="Infinity"
                            maxWidth="Infinity"
                            spacing="10"
                            styleClass="admin-option"
                            GridPane.columnIndex="3">

                        <Label
                                styleClass="admin-option-title"
                                text="Configuración del aplicativo"/>

                        <Label
                                styleClass="admin-option-description"
                                text="Apartado solo disponible para el dueño o administradores con permiso."
                                wrapText="true"/>

                        <Button
                                maxWidth="Infinity"
                                styleClass="admin-button"
                                onAction="#appConfig"
                                text="Gestionar configuración"/>

                    </VBox>



                    <!-- SECTORES  aqui me falta xd-->






                    <!-- ROLES Y PERMISOS-->


                    <VBox
                            fx:id="optRoles"
                            maxHeight="Infinity"
                            maxWidth="Infinity"
                            spacing="10"
                            styleClass="admin-option"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="1">

                        <Label
                                styleClass="admin-option-title"
                                text="Roles y permisos"/>

                        <Label
                                styleClass="admin-option-description"
                                text="Administra los roles del sistema, usuarios asignados y permisos disponibles."
                                wrapText="true"/>


                        <!-- RESUMEN -->

                        <HBox
                                alignment="CENTER_LEFT"
                                spacing="8">

                            <Label
                                    fx:id="lblRolesCount"
                                    text="0 roles"
                                    styleClass="admin-role-stat"/>

                            <Label
                                    text="•"
                                    styleClass="secondary-text"/>

                            <Label
                                    fx:id="lblUsersWithRoleCount"
                                    text="0 usuarios"
                                    styleClass="admin-role-stat"/>

                        </HBox>


                        <Region VBox.vgrow="ALWAYS"/>


                        <Button
                                maxWidth="Infinity"
                                styleClass="admin-button"
                                onAction="#appRolPermission"
                                text="Gestionar roles"/>

                    </VBox>


                    <rowConstraints>
                        <RowConstraints vgrow="ALWAYS"/>
                        <RowConstraints vgrow="ALWAYS"/>
                    </rowConstraints>

                </GridPane>

            </VBox>

        </VBox>

    </ScrollPane>

</AnchorPane>