<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane
        styleClass="content-style"
        xmlns="http://javafx.com/javafx/17.0.12"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.example.servinet.ui.controllers.center.TecnicosController">

    <ScrollPane
            fitToWidth="true"
            hbarPolicy="NEVER"
            styleClass="transparent-scroll"
            vbarPolicy="AS_NEEDED"
            AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0"
            AnchorPane.topAnchor="0.0">

        <GridPane
                hgap="20"
                vgap="20"
                style="-fx-padding: 20px;">

            <columnConstraints>

                <ColumnConstraints
                        hgrow="ALWAYS"/>

                <ColumnConstraints
                        hgrow="ALWAYS"/>

            </columnConstraints>

            <rowConstraints>

                <RowConstraints
                        minHeight="10.0"
                        prefHeight="30.0"
                        vgrow="NEVER"/>

                <RowConstraints
                        vgrow="NEVER"/>

                <RowConstraints
                        vgrow="ALWAYS"/>

            </rowConstraints>

            <children>

                <Label
                        styleClass="content-title"
                        text="Técnicos"/>

                <GridPane
                        hgap="12"
                        vgap="12"
                        GridPane.columnSpan="2"
                        GridPane.rowIndex="1">

                    <columnConstraints>

                        <ColumnConstraints
                                hgrow="ALWAYS"/>

                        <ColumnConstraints
                                hgrow="ALWAYS"/>

                        <ColumnConstraints
                                hgrow="ALWAYS"/>

                        <ColumnConstraints
                                hgrow="ALWAYS"/>

                    </columnConstraints>


                    <VBox
                            spacing="5"
                            styleClass="admin-option">

                        <Label
                                styleClass="secondary-text"
                                text="Técnicos activos"/>

                        <Label
                                fx:id="lblActiveTechnicians"
                                styleClass="primary-text"
                                text="0"/>

                    </VBox>

                    <VBox
                            spacing="5"
                            styleClass="admin-option"
                            GridPane.columnIndex="1">

                        <Label
                                styleClass="secondary-text"
                                text="Disponibles"/>

                        <Label
                                fx:id="lblAvailableTechnicians"
                                styleClass="primary-text"
                                text="0"/>

                    </VBox>

                    <VBox
                            spacing="5"
                            styleClass="admin-option"
                            GridPane.columnIndex="2">

                        <Label
                                styleClass="secondary-text"
                                text="En instalación"/>

                        <Label
                                fx:id="lblTechniciansWorking"
                                styleClass="primary-text"
                                text="0"/>

                    </VBox>

                    <VBox
                            spacing="5"
                            styleClass="admin-option"
                            GridPane.columnIndex="3">

                        <Label
                                styleClass="secondary-text"
                                text="Instalaciones realizadas hoy"/>

                        <Label
                                fx:id="lblInstallationsToday"
                                styleClass="primary-text"
                                text="0"/>

                    </VBox>

                </GridPane>


                <!-- ================================================= -->
                <!-- LISTA DE TÉCNICOS -->
                <!-- ================================================= -->

                <VBox
                        spacing="15"
                        GridPane.rowIndex="2">

                    <!-- CABECERA -->

                    <VBox
                            spacing="3">

                        <Label
                                styleClass="primary-text"
                                text="Técnicos"/>

                        <Label
                                styleClass="tertiary-text"
                                text="Consulta el estado y actividad de cada técnico."
                                wrapText="true"/>

                    </VBox>


                    <!-- FILTROS -->

                    <HBox
                            alignment="CENTER_LEFT"
                            spacing="8">

                        <TextField
                                fx:id="txtSearchTechnician"
                                promptText="Buscar técnico..."
                                styleClass="secondary-input"
                                HBox.hgrow="ALWAYS"/>

                        <ComboBox
                                fx:id="cmbTechnicalFilter"
                                promptText="Selecciona un filtro"
                                styleClass="secondary-combo"/>

                        <Button
                                fx:id="btnClearTechnicianFilters"
                                onAction="#clearTechnicalFilters"
                                styleClass="secondary-button"
                                text="Limpiar"/>

                    </HBox>


                    <!-- LISTA -->

                    <ScrollPane
                            fx:id="technicianScroll"
                            fitToWidth="true"
                            hbarPolicy="NEVER"
                            vbarPolicy="AS_NEEDED"
                            styleClass="users-scroll"
                            VBox.vgrow="ALWAYS">

                        <VBox
                                fx:id="technicianList"
                                fillWidth="true"
                                spacing="12"
                                maxWidth="Infinity"
                                styleClass="users-list">

                        </VBox>

                    </ScrollPane>

                </VBox>


                <!-- ================================================= -->
                <!-- INFORMACIÓN DEL TÉCNICO SELECCIONADO -->
                <!-- ================================================= -->

                <VBox
                        spacing="15"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="2">

                        <VBox
                                spacing="8"
                                styleClass="admin-option">

                            <VBox spacing="12">

                                <Label
                                        styleClass="primary-text"
                                        text="Información del técnico"/>

                                <GridPane hgap="16" vgap="12">

                                    <columnConstraints>
                                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                                    </columnConstraints>

                                    <!-- Nombre -->
                                    <VBox spacing="4">
                                        <Label styleClass="secondary-text" text="Nombre completo"/>
                                        <Label
                                                fx:id="lblTechnicianName"
                                                styleClass="primary-text"
                                                text="Sin información"
                                                wrapText="true"/>
                                    </VBox>

                                    <!-- Email -->
                                    <VBox spacing="4" GridPane.columnIndex="1">
                                        <Label styleClass="secondary-text" text="Correo electrónico"/>
                                        <Label
                                                fx:id="lblTechnicianEmail"
                                                styleClass="primary-text"
                                                text="Sin información"
                                                wrapText="true"/>
                                    </VBox>

                                    <!-- Teléfono -->
                                    <VBox spacing="4" GridPane.rowIndex="1">
                                        <Label styleClass="secondary-text" text="Teléfono"/>
                                        <Label
                                                fx:id="lblTechnicianPhone"
                                                styleClass="primary-text"
                                                text="Sin información"/>
                                    </VBox>

                                    <!-- UUID -->
                                    <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                        <Label styleClass="secondary-text" text="UUID"/>
                                        <Label
                                                fx:id="lblTechnicianUuid"
                                                styleClass="primary-text"
                                                text="Sin información"
                                                wrapText="true"/>
                                    </VBox>

                                </GridPane>

                                <Separator/>

                                <Label
                                        styleClass="primary-text"
                                        text="Instalación actual"/>

                                <GridPane hgap="16" vgap="12">

                                    <columnConstraints>
                                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                                    </columnConstraints>

                                    <!-- Código -->
                                    <VBox spacing="4">
                                        <Label styleClass="secondary-text" text="Código de instalación"/>
                                        <Label
                                                fx:id="lblCurrentInstallation"
                                                styleClass="primary-text"
                                                text="Sin instalación"
                                                wrapText="true"/>
                                    </VBox>

                                    <!-- Estado -->
                                    <VBox spacing="4" GridPane.columnIndex="1">
                                        <Label styleClass="secondary-text" text="Estado"/>
                                        <Label
                                                fx:id="lblCurrentInstallationStatus"
                                                styleClass="primary-text"
                                                text="Sin actividad"
                                                wrapText="true"/>
                                    </VBox>

                                    <!-- Cliente -->
                                    <VBox spacing="4" GridPane.rowIndex="1">
                                        <Label styleClass="secondary-text" text="Cliente"/>
                                        <Label
                                                fx:id="lblCurrentClient"
                                                styleClass="primary-text"
                                                text="Sin información"
                                                wrapText="true"/>
                                    </VBox>

                                    <!-- Ubicación -->
                                    <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                        <Label styleClass="secondary-text" text="Ubicación"/>
                                        <Label
                                                fx:id="lblCurrentLocation"
                                                styleClass="primary-text"
                                                text="Sin información"
                                                wrapText="true"/>
                                    </VBox>

                                </GridPane>
                                <Separator/>
                        </VBox>


                        <!-- ========================================= -->
                        <!-- HISTORIAL -->
                        <!-- ========================================= -->

                        <VBox
                                spacing="10">

                            <HBox
                                    alignment="CENTER_LEFT">

                                <VBox
                                        spacing="3">

                                    <Label
                                            styleClass="primary-text"
                                            text="Historial de instalaciones"/>

                                    <Label
                                            styleClass="tertiary-text"
                                            text="Instalaciones realizadas por el técnico seleccionado."
                                            wrapText="true"/>

                                </VBox>

                                <Pane
                                        HBox.hgrow="ALWAYS"/>

                                <Button
                                        fx:id="btnRefreshHistorial"
                                        onAction="#showInstallationHistory"
                                        styleClass="secondary-button"
                                        text="Actualizar historial"/>

                            </HBox>


                            <ScrollPane
                                    fx:id="installationHistoryScroll"
                                    fitToWidth="true"
                                    hbarPolicy="NEVER"
                                    styleClass="users-scroll"
                                    vbarPolicy="AS_NEEDED"
                                    VBox.vgrow="ALWAYS">

                                <VBox
                                        fx:id="installationHistoryList"
                                        fillWidth="true"
                                        spacing="10"
                                        styleClass="users-list">


                                    <!-- INSTALACIÓN HISTORIAL 1 -->




                                    <!-- INSTALACIÓN HISTORIAL 2 -->

                                    <VBox
                                            spacing="8"
                                            styleClass="admin-option">

                                        <HBox
                                                alignment="CENTER_LEFT">

                                            <VBox
                                                    spacing="3">

                                                <Label
                                                        styleClass="admin-option-title"
                                                        text="INS-0042"/>

                                                <Label
                                                        styleClass="secondary-text"
                                                        text="Hoy • 11:20"/>

                                            </VBox>

                                            <Pane
                                                    HBox.hgrow="ALWAYS"/>

                                            <Label
                                                    styleClass="quaternary-text"
                                                    text="COMPLETADA"/>

                                        </HBox>


                                        <GridPane
                                                hgap="12">

                                            <columnConstraints>

                                                <ColumnConstraints
                                                        hgrow="ALWAYS"/>

                                                <ColumnConstraints
                                                        hgrow="ALWAYS"/>

                                            </columnConstraints>


                                            <VBox
                                                    spacing="3">

                                                <Label
                                                        styleClass="secondary-text"
                                                        text="Cliente"/>

                                                <Label
                                                        styleClass="primary-text"
                                                        text="María López"/>

                                            </VBox>


                                            <VBox
                                                    spacing="3"
                                                    GridPane.columnIndex="1">

                                                <Label
                                                        styleClass="secondary-text"
                                                        text="Plan"/>

                                                <Label
                                                        styleClass="primary-text"
                                                        text="Internet 100 Mbps"/>

                                            </VBox>

                                        </GridPane>


                                        <Label
                                                styleClass="admin-option-description"
                                                text="Urbanización residencial - zona sur"
                                                wrapText="true"/>

                                    </VBox>


                                    <!-- INSTALACIÓN HISTORIAL 3 -->

                                    <VBox
                                            spacing="8"
                                            styleClass="admin-option">

                                        <HBox
                                                alignment="CENTER_LEFT">

                                            <VBox
                                                    spacing="3">

                                                <Label
                                                        styleClass="admin-option-title"
                                                        text="INS-0039"/>

                                                <Label
                                                        styleClass="secondary-text"
                                                        text="Ayer • 16:45"/>

                                            </VBox>

                                            <Pane
                                                    HBox.hgrow="ALWAYS"/>

                                            <Label
                                                    styleClass="quaternary-text"
                                                    text="COMPLETADA"/>

                                        </HBox>


                                        <GridPane
                                                hgap="12">

                                            <columnConstraints>

                                                <ColumnConstraints
                                                        hgrow="ALWAYS"/>

                                                <ColumnConstraints
                                                        hgrow="ALWAYS"/>

                                            </columnConstraints>


                                            <VBox
                                                    spacing="3">

                                                <Label
                                                        styleClass="secondary-text"
                                                        text="Cliente"/>

                                                <Label
                                                        styleClass="primary-text"
                                                        text="Pedro Ruiz"/>

                                            </VBox>


                                            <VBox
                                                    spacing="3"
                                                    GridPane.columnIndex="1">

                                                <Label
                                                        styleClass="secondary-text"
                                                        text="Plan"/>

                                                <Label
                                                        styleClass="primary-text"
                                                        text="Internet 100 Mbps"/>

                                            </VBox>

                                        </GridPane>


                                        <Label
                                                styleClass="admin-option-description"
                                                text="Centro poblado - zona este"
                                                wrapText="true"/>

                                    </VBox>

                                </VBox>

                            </ScrollPane>

                        </VBox>

                    </VBox>

                </VBox>

            </children>

        </GridPane>

    </ScrollPane>

</AnchorPane>