<?xml version="1.0" encoding="UTF-8"?>

    <?import javafx.scene.control.*?>
    <?import javafx.scene.layout.*?>

<AnchorPane
        styleClass="content-style"
        xmlns="http://javafx.com/javafx/17.0.12"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.example.servinet.ui.controllers.center.VentasMenuController">

    <ScrollPane
            fitToWidth="true"
            hbarPolicy="NEVER"
            styleClass="transparent-scroll"
            vbarPolicy="AS_NEEDED"
            AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0"
            AnchorPane.topAnchor="0.0">

        <VBox
                fillWidth="true"
                spacing="20"
                style="-fx-padding: 20px;">


            <!-- ================================================= -->
            <!-- TÍTULO -->
            <!-- ================================================= -->

            <VBox spacing="3">

                <Label
                        styleClass="content-title"
                        text="Ventas"/>

                <Label
                        styleClass="tertiary-text"
                        text="Gestiona tus ofertas, contratos y rendimiento comercial."/>

            </VBox>


            <!-- ================================================= -->
            <!-- RESUMEN DEL VENDEDOR -->
            <!-- ================================================= -->

            <VBox
                    spacing="15"
                    styleClass="admin-option">

                <VBox spacing="3">

                    <Label
                            styleClass="primary-text"
                            text="Resumen de ventas"/>

                    <Label
                            styleClass="tertiary-text"
                            text="Consulta rápidamente el estado de tu actividad comercial."/>

                </VBox>


                <GridPane
                        hgap="12"
                        vgap="12">

                    <columnConstraints>

                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints hgrow="ALWAYS"/>

                    </columnConstraints>


                    <!-- VENTAS DEL MES -->

                    <VBox
                            spacing="5"
                            styleClass="admin-option">

                        <Label
                                styleClass="secondary-text"
                                text="Ventas este mes"/>

                        <Label
                                fx:id="lblMonthlySales"
                                styleClass="primary-text"
                                text="0"/>

                        <Label
                                styleClass="quaternary-text"
                                text="Contratos registrados"/>

                    </VBox>


                    <!-- VENTAS HOY -->

                    <VBox
                            spacing="5"
                            styleClass="admin-option"
                            GridPane.columnIndex="1">

                        <Label
                                styleClass="secondary-text"
                                text="Ventas de hoy"/>

                        <Label
                                fx:id="lblTodaySales"
                                styleClass="primary-text"
                                text="0"/>

                        <Label
                                styleClass="quaternary-text"
                                text="Contratos realizados"/>

                    </VBox>


                    <!-- COMISIÓN -->

                    <VBox
                            spacing="5"
                            styleClass="admin-option"
                            GridPane.columnIndex="2">

                        <Label
                                styleClass="secondary-text"
                                text="Comisión"/>

                        <Label
                                fx:id="lblMonthlyCommission"
                                styleClass="primary-text"
                                text="S/ 0.00"/>

                        <Label
                                styleClass="quaternary-text"
                                text="Estimado del mes"/>

                    </VBox>


                    <!-- OBJETIVO -->

                    <VBox
                            spacing="5"
                            styleClass="admin-option"
                            GridPane.columnIndex="3">

                        <Label
                                styleClass="secondary-text"
                                text="Objetivo mensual"/>

                        <Label
                                fx:id="lblMonthlyGoal"
                                styleClass="primary-text"
                                text="0 %"/>

                        <Label
                                styleClass="quaternary-text"
                                text="Progreso"/>

                    </VBox>

                </GridPane>

            </VBox>


            <!-- ================================================= -->
            <!-- ACCIONES PRINCIPALES -->
            <!-- ================================================= -->

            <VBox
                    spacing="15">

                <VBox spacing="3">

                    <Label
                            styleClass="primary-text"
                            text="Acciones de ventas"/>

                    <Label
                            styleClass="tertiary-text"
                            text="Accede rápidamente a las herramientas principales para realizar ventas."/>

                </VBox>


                <GridPane
                        hgap="15"
                        vgap="15">

                    <columnConstraints>

                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints hgrow="ALWAYS"/>

                    </columnConstraints>


                    <!-- NUEVO CONTRATO -->

                    <VBox
                            spacing="10"
                            styleClass="admin-option">

                        <Label
                                styleClass="admin-option-title"
                                text="Nuevo contrato"/>

                        <Label
                                styleClass="admin-option-description"
                                text="Registra un nuevo cliente y configura su servicio de internet."
                                wrapText="true"/>

                        <Button
                                maxWidth="Infinity"
                                onAction="#newContract"
                                styleClass="admin-button"
                                text="Realizar nuevo contrato"/>

                    </VBox>


                    <!-- OFERTAS -->

                    <VBox
                            spacing="10"
                            styleClass="admin-option"
                            GridPane.columnIndex="1">

                        <Label
                                styleClass="admin-option-title"
                                text="Ofertas y planes"/>

                        <Label
                                styleClass="admin-option-description"
                                text="Consulta los planes, promociones y ofertas disponibles para tus clientes."
                                wrapText="true"/>

                        <Button
                                maxWidth="Infinity"
                                onAction="#showOffers"
                                styleClass="admin-button"
                                text="Ver ofertas"/>

                    </VBox>


                    <!-- CONTRATOS -->

                    <VBox
                            spacing="10"
                            styleClass="admin-option"
                            GridPane.columnIndex="2">

                        <Label
                                styleClass="admin-option-title"
                                text="Mis contratos"/>

                        <Label
                                styleClass="admin-option-description"
                                text="Consulta y edita los contratos registrados por ti."
                                wrapText="true"/>

                        <Button
                                maxWidth="Infinity"
                                onAction="#showContracts"
                                styleClass="admin-button"
                                text="Gestionar contratos"/>

                    </VBox>

                </GridPane>

            </VBox>


            <!-- ================================================= -->
            <!-- OFERTAS DISPONIBLES -->
            <!-- ================================================= -->

            <VBox
                    spacing="15"
                    styleClass="admin-option">

                <HBox
                        alignment="CENTER_LEFT">

                    <VBox spacing="3">

                        <Label
                                styleClass="primary-text"
                                text="Ofertas disponibles"/>

                        <Label
                                styleClass="tertiary-text"
                                text="Planes y promociones que puedes ofrecer actualmente a tus clientes."/>

                    </VBox>

                    <Pane HBox.hgrow="ALWAYS"/>

                    <Button
                            onAction="#showOffers"
                            styleClass="secondary-button"
                            text="Ver todas"/>

                </HBox>


                <VBox
                        fx:id="offersList"
                        fillWidth="true"
                        spacing="10">


                    <!-- OFERTA 1 -->

                    <HBox
                            alignment="CENTER_LEFT"
                            spacing="15"
                            styleClass="user-row">

                        <VBox
                                spacing="3"
                                HBox.hgrow="ALWAYS">

                            <Label
                                    styleClass="primary-text"
                                    text="Internet 100 Mbps"/>

                            <Label
                                    styleClass="secondary-text"
                                    text="100 Mbps • Instalación incluida"/>

                            <Label
                                    styleClass="tertiary-text"
                                    text="Oferta vigente para nuevos contratos."
                                    wrapText="true"/>

                        </VBox>


                        <VBox
                                alignment="CENTER_RIGHT"
                                spacing="3">

                            <Label
                                    styleClass="primary-text"
                                    text="S/ 59.90"/>

                            <Label
                                    styleClass="quaternary-text"
                                    text="mensual"/>

                        </VBox>


                        <Button
                                onAction="#selectOffer"
                                styleClass="secondary-button"
                                text="Usar oferta"/>

                    </HBox>


                    <!-- OFERTA 2 -->

                    <HBox
                            alignment="CENTER_LEFT"
                            spacing="15"
                            styleClass="user-row">

                        <VBox
                                spacing="3"
                                HBox.hgrow="ALWAYS">

                            <Label
                                    styleClass="primary-text"
                                    text="Internet 200 Mbps"/>

                            <Label
                                    styleClass="secondary-text"
                                    text="200 Mbps • Instalación incluida"/>

                            <Label
                                    styleClass="tertiary-text"
                                    text="Plan recomendado para hogares con varios dispositivos."
                                    wrapText="true"/>

                        </VBox>


                        <VBox
                                alignment="CENTER_RIGHT"
                                spacing="3">

                            <Label
                                    styleClass="primary-text"
                                    text="S/ 79.90"/>

                            <Label
                                    styleClass="quaternary-text"
                                    text="mensual"/>

                        </VBox>


                        <Button
                                onAction="#selectOffer"
                                styleClass="secondary-button"
                                text="Usar oferta"/>

                    </HBox>


                    <!-- OFERTA 3 -->

                    <HBox
                            alignment="CENTER_LEFT"
                            spacing="15"
                            styleClass="user-row">

                        <VBox
                                spacing="3"
                                HBox.hgrow="ALWAYS">

                            <Label
                                    styleClass="primary-text"
                                    text="Internet 300 Mbps"/>

                            <Label
                                    styleClass="secondary-text"
                                    text="300 Mbps • Oferta promocional"/>

                            <Label
                                    styleClass="tertiary-text"
                                    text="Mayor velocidad para clientes con alto consumo."
                                    wrapText="true"/>

                        </VBox>


                        <VBox
                                alignment="CENTER_RIGHT"
                                spacing="3">

                            <Label
                                    styleClass="primary-text"
                                    text="S/ 99.90"/>

                            <Label
                                    styleClass="quaternary-text"
                                    text="mensual"/>

                        </VBox>


                        <Button
                                onAction="#selectOffer"
                                styleClass="secondary-button"
                                text="Usar oferta"/>

                    </HBox>

                </VBox>

            </VBox>


            <!-- ================================================= -->
            <!-- CONTRATOS RECIENTES -->
            <!-- ================================================= -->

            <VBox
                    spacing="15"
                    styleClass="admin-option">

                <HBox
                        alignment="CENTER_LEFT">

                    <VBox spacing="3">

                        <Label
                                styleClass="primary-text"
                                text="Mis contratos recientes"/>

                        <Label
                                styleClass="tertiary-text"
                                text="Últimos contratos registrados por el vendedor."/>

                    </VBox>

                    <Pane HBox.hgrow="ALWAYS"/>

                    <Button
                            onAction="#showContracts"
                            styleClass="secondary-button"
                            text="Ver contratos"/>

                </HBox>


                <VBox
                        fx:id="recentContractsList"
                        fillWidth="true"
                        spacing="8">


                    <!-- CONTRATO -->

                    <HBox
                            alignment="CENTER_LEFT"
                            spacing="12"
                            styleClass="user-row">

                        <VBox
                                spacing="3"
                                HBox.hgrow="ALWAYS">

                            <Label
                                    styleClass="primary-text"
                                    text="Nuevo contrato"/>

                            <Label
                                    styleClass="secondary-text"
                                    text="Cliente • Internet 100 Mbps"/>

                        </VBox>

                        <Label
                                styleClass="quaternary-text"
                                text="ACTIVO"/>

                        <Button
                                onAction="#editContract"
                                styleClass="secondary-button"
                                text="Editar"/>

                    </HBox>


                    <!-- CONTRATO -->

                    <HBox
                            alignment="CENTER_LEFT"
                            spacing="12"
                            styleClass="user-row">

                        <VBox
                                spacing="3"
                                HBox.hgrow="ALWAYS">

                            <Label
                                    styleClass="primary-text"
                                    text="Nuevo contrato"/>

                            <Label
                                    styleClass="secondary-text"
                                    text="Cliente • Internet 200 Mbps"/>

                        </VBox>

                        <Label
                                styleClass="quaternary-text"
                                text="PENDIENTE"/>

                        <Button
                                onAction="#editContract"
                                styleClass="secondary-button"
                                text="Editar"/>

                    </HBox>


                    <!-- CONTRATO -->

                    <HBox
                            alignment="CENTER_LEFT"
                            spacing="12"
                            styleClass="user-row">

                        <VBox
                                spacing="3"
                                HBox.hgrow="ALWAYS">

                            <Label
                                    styleClass="primary-text"
                                    text="Nuevo contrato"/>

                            <Label
                                    styleClass="secondary-text"
                                    text="Cliente • Internet 50 Mbps"/>

                        </VBox>

                        <Label
                                styleClass="quaternary-text"
                                text="ACTIVO"/>

                        <Button
                                onAction="#editContract"
                                styleClass="secondary-button"
                                text="Editar"/>

                    </HBox>

                </VBox>

            </VBox>


            <!-- ================================================= -->
            <!-- ESTADÍSTICAS -->
            <!-- ================================================= -->

            <VBox
                    spacing="15"
                    styleClass="admin-option">

                <HBox
                        alignment="CENTER_LEFT">

                    <VBox spacing="3">

                        <Label
                                styleClass="primary-text"
                                text="Mis estadísticas"/>

                        <Label
                                styleClass="tertiary-text"
                                text="Analiza tu rendimiento y progreso de ventas."/>

                    </VBox>

                    <Pane HBox.hgrow="ALWAYS"/>

                    <Button
                            onAction="#showStatistics"
                            styleClass="secondary-button"
                            text="Ver estadísticas"/>

                </HBox>


                <GridPane
                        hgap="15"
                        vgap="12">

                    <columnConstraints>

                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints hgrow="ALWAYS"/>

                    </columnConstraints>


                    <!-- SEMANA -->

                    <VBox
                            spacing="5">

                        <Label
                                styleClass="secondary-text"
                                text="Esta semana"/>

                        <Label
                                fx:id="lblWeeklySales"
                                styleClass="primary-text"
                                text="0 ventas"/>

                        <Label
                                fx:id="lblWeeklyGrowth"
                                styleClass="quaternary-text"
                                text="Sin variación"/>

                    </VBox>


                    <!-- MES -->

                    <VBox
                            spacing="5"
                            GridPane.columnIndex="1">

                        <Label
                                styleClass="secondary-text"
                                text="Este mes"/>

                        <Label
                                fx:id="lblMonthlyContracts"
                                styleClass="primary-text"
                                text="0 contratos"/>

                        <Label
                                fx:id="lblMonthlyGrowth"
                                styleClass="quaternary-text"
                                text="Sin variación"/>

                    </VBox>


                    <!-- CONVERSIÓN -->

                    <VBox
                            spacing="5"
                            GridPane.columnIndex="2">

                        <Label
                                styleClass="secondary-text"
                                text="Conversión"/>

                        <Label
                                fx:id="lblConversionRate"
                                styleClass="primary-text"
                                text="0 %"/>

                        <Label
                                styleClass="quaternary-text"
                                text="Clientes convertidos"/>

                    </VBox>

                </GridPane>

            </VBox>


            <!-- ================================================= -->
            <!-- CLIENTES POTENCIALES -->
            <!-- ================================================= -->

            <VBox
                    spacing="15"
                    styleClass="admin-option">

                <HBox
                        alignment="CENTER_LEFT">

                    <VBox spacing="3">

                        <Label
                                styleClass="primary-text"
                                text="Clientes potenciales"/>

                        <Label
                                styleClass="tertiary-text"
                                text="Personas interesadas que aún no han completado un contrato."/>

                    </VBox>

                    <Pane HBox.hgrow="ALWAYS"/>

                    <Button
                            onAction="#showProspects"
                            styleClass="secondary-button"
                            text="Ver clientes"/>

                </HBox>


                <HBox
                        spacing="12">

                    <VBox
                            spacing="5"
                            styleClass="admin-option"
                            HBox.hgrow="ALWAYS">

                        <Label
                                styleClass="secondary-text"
                                text="Nuevos interesados"/>

                        <Label
                                fx:id="lblNewProspects"
                                styleClass="primary-text"
                                text="0"/>

                    </VBox>


                    <VBox
                            spacing="5"
                            styleClass="admin-option"
                            HBox.hgrow="ALWAYS">

                        <Label
                                styleClass="secondary-text"
                                text="Por contactar"/>

                        <Label
                                fx:id="lblPendingProspects"
                                styleClass="primary-text"
                                text="0"/>

                    </VBox>


                    <VBox
                            spacing="5"
                            styleClass="admin-option"
                            HBox.hgrow="ALWAYS">

                        <Label
                                styleClass="secondary-text"
                                text="Seguimientos"/>

                        <Label
                                fx:id="lblFollowUps"
                                styleClass="primary-text"
                                text="0"/>

                    </VBox>

                </HBox>

            </VBox>


            <!-- ================================================= -->
            <!-- ACCIONES INFERIORES -->
            <!-- ================================================= -->

            <HBox
                    alignment="CENTER_RIGHT"
                    spacing="10">

                <Button
                        onAction="#showOffers"
                        styleClass="secondary-button"
                        text="Consultar ofertas"/>

                <Button
                        onAction="#showStatistics"
                        styleClass="secondary-button"
                        text="Mis estadísticas"/>

                <Button
                        onAction="#newContract"
                        styleClass="admin-button"
                        text="Nuevo contrato"/>

            </HBox>

        </VBox>

    </ScrollPane>

</AnchorPane>

