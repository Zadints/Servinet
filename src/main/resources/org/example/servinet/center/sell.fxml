<?xml version="1.0" encoding="UTF-8"?>

    <?import javafx.scene.control.*?>
    <?import javafx.scene.layout.*?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<AnchorPane
        styleClass="content-style"
        xmlns="http://javafx.com/javafx/17.0.12"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.example.servinet.ui.controllers.center.VentasMenuController">

    <ScrollPane
            fitToWidth="true"
            hbarPolicy="NEVER"
            styleClass="transparent-scroll"
            vbarPolicy="AS_NEEDED"
            AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0"
            AnchorPane.topAnchor="0.0">

        <VBox
                fillWidth="true"
                spacing="20"
                style="-fx-padding: 20px;">


            <!-- ================================================= -->
            <!-- TÍTULO -->
            <!-- ================================================= -->

            <VBox spacing="3">

                <Label
                        styleClass="content-title"
                        text="Ventas"/>

                <Label
                        styleClass="tertiary-text"
                        text="Gestiona tus ofertas, contratos y rendimiento comercial."/>

            </VBox>

            <Label fx:id="lblSinAccionesVentas"
                   text="Tu rol no tiene acciones disponibles en esta versión de Ventas."
                   wrapText="true"
                   visible="false"
                   managed="false"
                   styleClass="secondary-text"/>

            <!-- ================================================= -->
            <!-- RESUMEN DEL VENDEDOR -->
            <!-- =================================================

            <VBox fx:id="sectionResumenVentas"
                  spacing="15"
                  styleClass="admin-option">

                <VBox spacing="3">

                    <Label
                            styleClass="primary-text"
                            text="Resumen de ventas"/>

                    <Label
                            styleClass="tertiary-text"
                            text="Consulta rápidamente el estado de tu actividad comercial."/>

                </VBox>


                <GridPane
                        hgap="12"
                        vgap="12">

                    <columnConstraints>

                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints hgrow="ALWAYS"/>

                    </columnConstraints>




                    <VBox
                            spacing="5"
                            styleClass="admin-option">

                        <Label
                                styleClass="secondary-text"
                                text="Ventas este mes"/>

                        <Label
                                fx:id="lblVentasMes"
                                styleClass="primary-text"
                                text="0"/>

                        <Label
                                styleClass="quaternary-text"
                                text="Contratos registrados"/>

                    </VBox>




                    <VBox
                            spacing="5"
                            styleClass="admin-option"
                            GridPane.columnIndex="1">

                        <Label
                                styleClass="secondary-text"
                                text="Ventas de hoy"/>

                        <Label
                                fx:id="lblVentasHoy"
                                styleClass="primary-text"
                                text="0"/>

                        <Label
                                styleClass="quaternary-text"
                                text="Contratos realizados"/>

                    </VBox>




                    <VBox
                            spacing="5"
                            styleClass="admin-option"
                            GridPane.columnIndex="2">

                        <Label
                                styleClass="secondary-text"
                                text="Comisión"/>

                        <Label
                                fx:id="lblComision"
                                styleClass="primary-text"
                                text="S/ 0.00"/>

                        <Label
                                styleClass="quaternary-text"
                                text="Estimado del mes"/>

                    </VBox>




                    <VBox
                            spacing="5"
                            styleClass="admin-option"
                            GridPane.columnIndex="3">

                        <Label
                                styleClass="secondary-text"
                                text="Objetivo mensual"/>

                        <Label
                                fx:id="lblObjetivoMensual"
                                styleClass="primary-text"
                                text="0 %"/>

                        <Label
                                styleClass="quaternary-text"
                                text="Progreso"/>

                    </VBox>

                </GridPane>

            </VBox>

    -->
            <!-- ================================================= -->
            <!-- ACCIONES PRINCIPALES -->
            <!-- ================================================= -->

            <VBox
                    spacing="15">

                <VBox spacing="3">

                    <Label
                            styleClass="primary-text"
                            text="Acciones de ventas"/>

                    <Label
                            styleClass="tertiary-text"
                            text="Accede rápidamente a las herramientas principales para realizar ventas."/>

                </VBox>


                <GridPane
                        hgap="15"
                        vgap="15">

                    <columnConstraints>

                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints hgrow="ALWAYS"/>

                    </columnConstraints>


                    <!-- NUEVO CONTRATO -->

                    <VBox fx:id="cardNuevoContrato"
                          spacing="10"
                          styleClass="admin-option">

                        <Label
                                styleClass="admin-option-title"
                                text="Nuevo contrato"/>

                        <Label
                                styleClass="admin-option-description"
                                text="Registra un nuevo cliente y configura su servicio de internet."
                                wrapText="true"/>

                        <Button
                                fx:id="btnNewContract"
                                maxWidth="Infinity"
                                onAction="#newContract"
                                styleClass="admin-button"
                                text="Realizar nuevo contrato"/>

                    </VBox>


                    <!-- OFERTAS -->

                    <VBox
                            spacing="10"
                            styleClass="admin-option"
                            GridPane.columnIndex="1">

                        <Label
                                styleClass="admin-option-title"
                                text="Registrar pago de cliente"/>

                        <Label
                                styleClass="admin-option-description"
                                text="Registra el pago realizado por el cliente"
                                wrapText="true"/>

                        <Button
                                maxWidth="Infinity"
                                onAction="#showSelling"
                                styleClass="admin-button"
                                text="Registrar pago"/>

                    </VBox>

                </GridPane>

            </VBox>


            <!-- ================================================= -->
            <!-- OFERTAS DISPONIBLES -->
            <!-- ================================================= -->

            <VBox
                    spacing="15"
                    styleClass="admin-option">

                <HBox
                        alignment="CENTER_LEFT">

                    <VBox spacing="3">

                        <Label
                                styleClass="primary-text"
                                text="Ofertas disponibles"/>

                        <Label
                                styleClass="tertiary-text"
                                text="Planes y promociones que puedes ofrecer actualmente a tus clientes."/>

                    </VBox>

                    <Pane HBox.hgrow="ALWAYS"/>

                    <Button
                            onAction="#reloadOffers"
                            styleClass="secondary-button"
                            text="Recargar Ofertas"/>

                </HBox>


                <VBox
                        HBox.hgrow="ALWAYS"
                        fx:id="offersList"
                        fillWidth="true"
                        spacing="10">


                </VBox>

            </VBox>


            <!-- ================================================= -->
            <!-- CONTRATOS RECIENTES -->
            <!-- ================================================= -->

            <ScrollPane
                    maxHeight="400"
                    prefHeight="400"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    styleClass="admin-option">

                <content>
                    <VBox spacing="15" fillWidth="true">

                        <!-- ENCABEZADO -->

                        <HBox alignment="CENTER_LEFT">

                            <VBox spacing="3">

                                <Label
                                        styleClass="primary-text"
                                        text="Clientes en deuda"/>

                                <Label
                                        styleClass="tertiary-text"
                                        text="Contratos que presentan un retraso en sus pagos."/>

                            </VBox>

                            <Pane HBox.hgrow="ALWAYS"/>

                        </HBox>

                        <!-- BUSCADOR -->

                        <HBox fx:id="searchControls"
                              spacing="10"
                              alignment="CENTER_LEFT">

                            <ComboBox
                                    fx:id="cmbSearchType"
                                    prefWidth="150"
                                    styleClass="secondary-combo">

                                <items>
                                    <FXCollections fx:factory="observableArrayList">
                                        <String fx:value="Dni"/>
                                        <String fx:value="Nombre"/>
                                        <String fx:value="Apellido"/>
                                        <String fx:value="Direccion"/>
                                        <String fx:value="Telefono"/>
                                        <String fx:value="Whatsapp"/>
                                        <String fx:value="Plan"/>
                                    </FXCollections>
                                </items>

                            </ComboBox>

                            <TextField
                                    fx:id="txtSearchClient"
                                    promptText="Buscar cliente..."
                                    styleClass="secondary-input"
                                    HBox.hgrow="ALWAYS"/>

                            <Label
                                    fx:id="lblCoincidence"
                                    styleClass="secondary-text"
                                    text="0 Coincidencias"/>

                            <Button
                                    fx:id="btnClearSearch"
                                    onAction="#clearSearch"
                                    styleClass="tertiary-button"
                                    text="Limpiar"/>

                        </HBox>

                        <!-- LISTA DE CONTRATOS -->

                        <VBox
                                fx:id="recentContractsList"
                                spacing="8"
                                fillWidth="true">

                        </VBox>

                    </VBox>
                </content>

            </ScrollPane>


            <!-- ================================================= -->
            <!-- ACCIONES INFERIORES -->
            <!-- ================================================= -->

            <HBox
                    alignment="CENTER_RIGHT"
                    spacing="10">

                <Button
                        onAction="#showSelling"
                        styleClass="secondary-button"
                        text="Registrar Pago"/>

                <Button
                        onAction="#newContract"
                        styleClass="admin-button"
                        text="Nuevo contrato"/>

            </HBox>

        </VBox>

    </ScrollPane>

</AnchorPane>

