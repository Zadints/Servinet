<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane
        styleClass="content-style"
        xmlns="http://javafx.com/javafx/17.0.12"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.example.servinet.ui.controllers.center.VentasFormController">

    <ScrollPane
            fitToWidth="true"
            hbarPolicy="NEVER"
            styleClass="transparent-scroll"
            vbarPolicy="AS_NEEDED"
            AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0"
            AnchorPane.topAnchor="0.0">

        <VBox
                fillWidth="true"
                spacing="20"
                style="-fx-padding: 20px;">

            <!-- ================================================= -->
            <!-- TÍTULO -->
            <!-- ================================================= -->

            <VBox spacing="3">

                <Label
                        styleClass="content-title"
                        text="Nuevo Contrato"/>

                <Label
                        styleClass="tertiary-text"
                        text="Registra un nuevo cliente y configura el contrato de servicio de internet."/>

            </VBox>


            <!-- ================================================= -->
            <!-- DATOS DEL CLIENTE -->
            <!-- ================================================= -->

            <VBox
                    spacing="15"
                    styleClass="admin-option">

                <VBox spacing="3">

                    <Label
                            styleClass="primary-text"
                            text="Datos del cliente"/>

                    <Label
                            styleClass="tertiary-text"
                            text="Información necesaria para registrar al cliente."/>

                </VBox>


                <GridPane
                        hgap="15"
                        vgap="12">

                    <columnConstraints>

                        <ColumnConstraints
                                halignment="RIGHT"
                                hgrow="NEVER"/>

                        <ColumnConstraints
                                hgrow="ALWAYS"
                                minWidth="250"/>

                        <ColumnConstraints
                                halignment="RIGHT"
                                hgrow="NEVER"/>

                        <ColumnConstraints
                                hgrow="ALWAYS"
                                minWidth="250"/>

                    </columnConstraints>


                    <!-- NOMBRE -->

                    <Label
                            styleClass="secondary-text"
                            text="Nombre completo"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="0"/>

                    <TextField
                            fx:id="txtNombre"
                            promptText="Nombre completo"
                            styleClass="secondary-input"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="0"/>


                    <!-- DNI -->

                    <Label
                            styleClass="secondary-text"
                            text="Apellido"
                            GridPane.columnIndex="2"
                            GridPane.rowIndex="0"/>

                    <TextField
                            fx:id="txtApellido"
                            promptText="8 dígitos"
                            styleClass="secondary-input"
                            GridPane.columnIndex="3"
                            GridPane.rowIndex="0"/>


                    <!-- TELÉFONO -->

                    <Label
                            styleClass="secondary-text"
                            text="Teléfono"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="1"/>

                    <TextField
                            fx:id="txtTelefono"
                            promptText="Número de teléfono"
                            styleClass="secondary-input"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="1"/>


                    <Label
                            styleClass="secondary-text"
                            text="DNI"
                            GridPane.columnIndex="2"
                            GridPane.rowIndex="1"/>

                    <TextField
                            fx:id="txtDni"
                            promptText="Dirección del cliente"
                            styleClass="secondary-input"
                            GridPane.columnIndex="3"
                            GridPane.rowIndex="1"/>


                    <!-- SECTOR -->

                    <Label
                            styleClass="secondary-text"
                            text="Direccion"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="2"/>

                    <TextField
                            fx:id="txtDireccion"
                            promptText="Sector o zona"
                            styleClass="secondary-input"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="2"/>

                    <Label
                            styleClass="secondary-text"
                            text="Email"
                            GridPane.columnIndex="2"
                            GridPane.rowIndex="2"/>

                    <TextField
                            fx:id="txtEmail"
                            promptText="Sector o zona"
                            styleClass="secondary-input"
                            GridPane.columnIndex="3"
                            GridPane.rowIndex="2"/>

                </GridPane>

            </VBox>


            <!-- ================================================= -->
            <!-- SERVICIO -->
            <!-- ================================================= -->

            <VBox
                    spacing="15"
                    styleClass="admin-option">

                <VBox spacing="3">

                    <Label
                            styleClass="primary-text"
                            text="Servicio de internet"/>

                    <Label
                            styleClass="tertiary-text"
                            text="Selecciona el plan y la antena que tendrá asignado el cliente."/>

                </VBox>


                <GridPane
                        hgap="15"
                        vgap="12">

                    <columnConstraints>

                        <ColumnConstraints
                                halignment="RIGHT"
                                hgrow="NEVER"/>

                        <ColumnConstraints
                                hgrow="ALWAYS"
                                minWidth="250"/>

                        <ColumnConstraints
                                halignment="RIGHT"
                                hgrow="NEVER"/>

                        <ColumnConstraints
                                hgrow="ALWAYS"
                                minWidth="250"/>

                    </columnConstraints>


                    <!-- PLAN -->

                    <Label
                            styleClass="secondary-text"
                            text="Plan"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="0"/>

                    <ComboBox
                            fx:id="cmbPlan"
                            maxWidth="Infinity"
                            promptText="Seleccionar plan"
                            styleClass="secondary-combo"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="0"/>


                    <VBox spacing="12"
                          alignment="CENTER_LEFT"
                          styleClass="secondary-text"
                          GridPane.columnIndex="2"
                          GridPane.columnSpan="3"
                          GridPane.rowIndex="0">

                        <Label text="Fibra 100"
                               styleClass="plan-name"/>

                        <Label text="100 Mbps"
                               styleClass="plan-speed"/>

                        <Label text="S/ 89.90"
                               styleClass="plan-price"/>

                        <Label text="PROMOCIÓN"
                               styleClass="promo-badge"/>

                        <Label text="PENDIENTE"
                               styleClass="status-badge"/>

                    </VBox>


                </GridPane>

            </VBox>

            <!-- ================================================= -->
            <!-- PRIMER PAGO -->
            <!-- ================================================= -->

            <VBox
                    spacing="15"
                    styleClass="admin-option">

                <VBox spacing="3">

                    <Label
                            styleClass="primary-text"
                            text="Primer pago"/>

                    <Label
                            styleClass="tertiary-text"
                            text="Registra el primer pago correspondiente al servicio contratado."/>

                </VBox>


                <GridPane hgap="20"
                          vgap="12">

                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT"
                                           hgrow="NEVER"/>

                        <ColumnConstraints hgrow="ALWAYS"
                                           minWidth="250"/>

                        <ColumnConstraints minWidth="220"
                                           prefWidth="260"
                                           hgrow="NEVER"/>
                    </columnConstraints>

                    <!-- MES -->
                    <Label text="Mes"
                           styleClass="secondary-text"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="0"/>

                    <Label fx:id="lblMesPago"
                           text="Octubre 2026"
                           styleClass="secondary-text"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"/>

                    <!-- MONTO -->
                    <Label text="Monto"
                           styleClass="secondary-text"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="1"/>

                    <Label fx:id="lblMontoPago"
                           text="S/ 89.90"
                           styleClass="secondary-text"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"/>

                    <!-- FECHA AUTOMÁTICA -->
                    <Label text="Fecha de pago"
                           styleClass="secondary-text"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="2"/>

                    <Label fx:id="lblFechaPago"
                           text="09/10/2026"
                           styleClass="secondary-text"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="2"/>

                    <!-- MÉTODO DE PAGO -->
                    <Label text="Método de pago"
                           styleClass="secondary-text"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="3"/>

                    <ComboBox fx:id="cmbMetodoPago"
                              maxWidth="Infinity"
                              promptText="Seleccionar método"
                              styleClass="secondary-combo"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="3"/>

                    <!-- OBSERVACIÓN -->
                    <Label text="Observación"
                           styleClass="secondary-text"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="4"
                           GridPane.valignment="TOP"/>

                    <TextArea fx:id="txtObservacion"
                              prefRowCount="3"
                              promptText="Observación del pago..."
                              wrapText="true"
                              maxWidth="Infinity"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="4"/>

                    <!-- COMPROBANTE: IMAGEN A LA DERECHA -->
                    <VBox spacing="10"
                          alignment="TOP_CENTER"
                          styleClass="secondary-card"
                          GridPane.columnIndex="2"
                          GridPane.rowIndex="0"
                          GridPane.rowSpan="5">

                        <Label text="Comprobante de pago"
                               styleClass="secondary-text"/>

                        <ImageView fx:id="imgComprobante"
                                   fitWidth="230"
                                   fitHeight="220"
                                   preserveRatio="true"
                                   smooth="true"/>

                        <Button fx:id="btnSubirComprobante"
                                text="Seleccionar imagen"
                                maxWidth="Infinity"
                                onAction="#seleccionarComprobante"
                                styleClass="secondary-button"/>

                        <Label fx:id="lblNombreComprobante"
                               text="Ninguna imagen seleccionada"
                               wrapText="true"
                               styleClass="secondary-text"/>

                    </VBox>

                </GridPane>

            </VBox>


            <!-- ================================================= -->
            <!-- RESUMEN -->
            <!-- ================================================= -->

            <VBox
                    spacing="12"
                    styleClass="admin-option">

                <Label
                        styleClass="primary-text"
                        text="Resumen de la venta"/>

                <HBox spacing="30">

                    <VBox spacing="3">

                        <Label
                                styleClass="quaternary-text"
                                text="Cliente"/>

                        <Label
                                fx:id="lblSummaryClient"
                                styleClass="primary-text"
                                text="Sin seleccionar"/>

                    </VBox>


                    <VBox spacing="3">

                        <Label
                                styleClass="quaternary-text"
                                text="Plan"/>

                        <Label
                                fx:id="lblSummaryPlan"
                                styleClass="primary-text"
                                text="Sin seleccionar"/>

                    </VBox>


                    <VBox spacing="3">

                        <Label
                                styleClass="quaternary-text"
                                text="Antena"/>

                        <Label
                                fx:id="lblSummaryAntenna"
                                styleClass="primary-text"
                                text="Sin seleccionar"/>

                    </VBox>


                    <VBox spacing="3">

                        <Label
                                styleClass="quaternary-text"
                                text="Monto"/>

                        <Label
                                fx:id="lblSummaryAmount"
                                styleClass="primary-text"
                                text="S/ 0.00"/>

                    </VBox>

                </HBox>

            </VBox>


            <!-- ================================================= -->
            <!-- BOTONES -->
            <!-- ================================================= -->

            <HBox
                    alignment="CENTER_RIGHT"
                    spacing="10">

                <Button
                        onAction="#closeForm"
                        styleClass="secondary-button"
                        text="Cancelar"/>

                <Button
                        onAction="#registerSale"
                        styleClass="primary-button"
                        text="Crear contrato y enviar comprobante"/>

            </HBox>

        </VBox>

    </ScrollPane>

</AnchorPane>